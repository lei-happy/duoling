# platform_sync 环境配置模板
# 复制本文件为 envs/.env.dev / envs/.env.prod 后按需填写
# 真实凭证文件不入库（已在 .gitignore 中排除）

# Console API 根地址（不带尾部斜杠）
#
# 注意：必须指向「后端 FastAPI 服务」而不是前端 Vite/Nginx，否则会 500。
#
# 取值场景：
#   .env.dev  本机开发：http://127.0.0.1:8000          ← 直连本机 uvicorn
#   .env.prod 生产容器：http://backend:8000            ← 容器内 docker compose 服务名
#                       （sync 是在 backend 容器内跑的，走 docker 内网最稳）
#
# 不要写 https://console.zhitu.me 或前端 Vite 端口（如 :5173），那会绕一大圈或失败。
CONSOLE_API_BASE=http://127.0.0.1:8000

# 同步专用账号（建议为该工具单独创建一个平台超管账号 sync-bot）
# 默认开发库的超级管理员是 13800000000 / admin123（见 seed_data.py）
CONSOLE_ADMIN_PHONE=13800000000
CONSOLE_ADMIN_PASSWORD=admin123

# HTTP 超时（秒）
CONSOLE_HTTP_TIMEOUT=30

# 单次失败后的重试次数
CONSOLE_HTTP_RETRIES=3

# 快照根目录（绝对路径或相对仓库根的路径）
# 留空则使用 backend/scripts/platform_sync/snapshots
SNAPSHOT_DIR=
