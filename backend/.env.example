# ============================================================
# 智途(ZhiTu) 后端服务环境变量配置
# ============================================================

# 应用配置
APP_NAME=ZhiTu
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=your-super-secret-key-change-in-production

# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库环境后缀
# 开发环境设为 _ci（库名如 zt_platform_ci）
# 生产环境留空（库名如 zt_platform）
DB_SUFFIX=_ci

# 平台数据库配置（MySQL）
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
PLATFORM_DB_USER=root
PLATFORM_DB_PASSWORD=your-db-password
PLATFORM_DB_NAME=zt_platform

# 租户数据库配置（默认连接信息，与平台库同一MySQL实例）
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USER=root
TENANT_DB_PASSWORD=your-db-password
TENANT_DB_PREFIX=zt_biz_

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 跨域配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:3000"]

# 日志配置
LOG_LEVEL=DEBUG
LOG_DIR=logs
