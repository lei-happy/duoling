# ============================================================
# 智途(ZhiTu) 生产环境变量配置
# 使用方法: 复制此文件到 deploy/docker/.env 并修改实际值
#   cp .env.production .env
# ============================================================

# ---- MySQL 数据库（宿主机已安装） ----
DB_USER=root
DB_PASSWORD=+S$<iW*-|lkQO9X6

# ---- 应用密钥（务必修改为随机字符串！） ----
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me-to-random-string-1
JWT_SECRET_KEY=change-me-to-random-string-2

# ---- 跨域配置 ----
CORS_ORIGINS=["https://www.zhitu.me","https://console.zhitu.me","https://wuliu.zhitu.me"]

# ---- SSL 证书邮箱（Let's Encrypt 通知用） ----
CERTBOT_EMAIL=your-email@example.com
