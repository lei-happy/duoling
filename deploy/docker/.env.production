# ============================================================
# 智途(ZhiTu) 生产环境变量配置
#
# Uvicorn worker 数（docker-compose 启动 backend 时使用；不配则默认 4）
# 建议：与 CPU 物理核数相同或略少，为宿主机上的 MySQL/Nginx/系统留余量。
# 例：4 核 16G 可设 4；若与大量容器同机可适当降到 2～3。
# UVICORN_WORKERS=4
# 使用方法: 复制此文件到 deploy/docker/.env 并填入真实值（.env 已忽略，勿把密钥写回本文件）
#   cp .env.production .env
#
# 注意: 所有值都必须用双引号包裹，避免特殊字符被 shell 解析！
# 本文件只放占位符，禁止写入真实密码 / AccessKey / JWT。
# ============================================================

# ---- MySQL 数据库（宿主机已安装） ----
DB_USER="root"
DB_PASSWORD="CHANGE_ME_DB_PASSWORD"

# ---- 应用密钥（务必修改为随机字符串！） ----
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY="CHANGE_ME_APP_SECRET_KEY"
JWT_SECRET_KEY="CHANGE_ME_JWT_SECRET_KEY"

# ---- 跨域配置 ----
# 驾驶员 H5 (driver.zhitu.me) 与企业端解耦，独立加入白名单
CORS_ORIGINS='["https://www.zhitu.me","https://console.zhitu.me","https://wuliu.zhitu.me","https://driver.zhitu.me"]'

# ---- 阿里云短信认证（DYPNS 号码认证服务） ----
ALIYUN_ACCESS_KEY_ID="CHANGE_ME_ALIYUN_ACCESS_KEY_ID"
ALIYUN_ACCESS_KEY_SECRET="CHANGE_ME_ALIYUN_ACCESS_KEY_SECRET"
ALIYUN_SMS_SIGN_NAME=速通互联验证码
ALIYUN_SMS_ENABLED=true

# ---- 高德地图 Web 服务 Key（后端 API：测距、路径规划等） ----
# 与 frontend/client 的 VITE_MAP_KEY / VITE_MAP_SECRET（JS API）不是同一套，需在高德控制台单独创建「Web服务」类型 Key
AMAP_WEB_SERVICE_KEY="CHANGE_ME_AMAP_WEB_SERVICE_KEY"

# ---- SSL 证书邮箱（Let's Encrypt 通知用） ----
CERTBOT_EMAIL="your-email@example.com"

# ---- 开放平台数据面（openapi 容器 + api.zhitu.me） ----
# 对外公网地址：租户端「复制 MCP 配置」生成的 url 与 REST 请求地址均以此为准，
# 必须与 nginx api.conf 的 server_name（api.zhitu.me）一致。
OPEN_PLATFORM_BASE_URL="https://api.zhitu.me"
# 数据面 uvicorn worker 数（独立于业务 backend 的 UVICORN_WORKERS）
# OPENAPI_WORKERS=2
# 单凭证每分钟调用上限（<=0 不限）与签名时间戳允许偏移（秒）
# OPEN_RATE_LIMIT_PER_MIN=600
# OPEN_TIMESTAMP_WINDOW_SEC=300
