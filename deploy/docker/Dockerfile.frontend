# ============================================================
# 智途(ZhiTu) 前端服务 Dockerfile
# 多阶段构建：构建 + Nginx 部署
# ============================================================

FROM node:20-alpine AS builder

ARG APP_DIR=console

WORKDIR /app

COPY frontend/${APP_DIR}/package.json ./
RUN npm install --registry=https://registry.npmmirror.com

COPY frontend/${APP_DIR} .
RUN npm run build

# ---- Nginx 部署 ----
FROM nginx:alpine

ARG APP_DIR=console

COPY deploy/nginx/${APP_DIR}.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
