# ============================================================
# 智途(ZhiTu) Nginx + 前端多阶段构建 Dockerfile
# 构建上下文: 项目根目录 (../..)
#
# 使用 BuildKit 时，独立阶段会自动并行执行
# DOCKER_BUILDKIT=1 docker build ...
# ============================================================

# ============================================================
# Stage 1: 构建产品官网 (www.zhitu.me)
# 官网不使用 workspace 依赖，保持 npm 独立构建
# ============================================================
FROM node:20-alpine AS website-builder

ENV NODE_OPTIONS="--max-old-space-size=4096"
WORKDIR /build/website

COPY frontend/website/package.json frontend/website/package-lock.json* ./
RUN npm install --registry=https://registry.npmmirror.com

COPY frontend/website/ .
COPY frontend/components/ /build/components/

RUN ln -s /build/website/node_modules /build/node_modules
RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build


# ============================================================
# Stage 2: pnpm workspace 依赖安装（console & client & driver-h5 共用）
# ============================================================
FROM node:20-alpine AS pnpm-deps

# 用 npm 全局安装 pnpm 并锁定大版本（pnpm 9 与 node 20 兼容良好）
# 历史上用过 `corepack prepare pnpm@latest`，但 corepack 与某些 pnpm 11.x 在新 node 中
# 会抛 ERR_VM_DYNAMIC_IMPORT_CALLBACK_MISSING；改用 npm 全局安装更稳定可控。
RUN npm install -g pnpm@9 --registry=https://registry.npmmirror.com

WORKDIR /build

COPY frontend/.npmrc frontend/pnpm-workspace.yaml frontend/package.json ./
COPY frontend/packages/ ./packages/
COPY frontend/console/package.json ./console/package.json
COPY frontend/client/package.json ./client/package.json
COPY frontend/driver-h5/package.json ./driver-h5/package.json

RUN pnpm install --frozen-lockfile 2>/dev/null || pnpm install --no-frozen-lockfile --registry=https://registry.npmmirror.com


# ============================================================
# Stage 3: 构建管理后台 (console.zhitu.me)
# ============================================================
FROM pnpm-deps AS console-builder

ENV NODE_OPTIONS="--max-old-space-size=4096"

COPY frontend/console/ ./console/
COPY frontend/components/ ./components/

WORKDIR /build/console
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build:app


# ============================================================
# Stage 4: 构建企业客户端 (wuliu.zhitu.me)
# ============================================================
FROM pnpm-deps AS client-builder

ENV NODE_OPTIONS="--max-old-space-size=4096"

COPY frontend/client/ ./client/
COPY frontend/components/ ./components/

WORKDIR /build/client
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build:app


# ============================================================
# Stage 5: 构建驾驶员 H5 (driver.zhitu.me)
# 与 console / client 共用 pnpm-deps；产物 dist 由 pnpm run build 生成
# （driver-h5 内部使用 `vue-tsc -b && vite build`，比 client 轻）
# ============================================================
FROM pnpm-deps AS driver-builder

ENV NODE_OPTIONS="--max-old-space-size=4096"

COPY frontend/driver-h5/ ./driver-h5/
COPY frontend/components/ ./components/

WORKDIR /build/driver-h5
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build


# ============================================================
# Stage 6: Nginx 生产镜像
# ============================================================
FROM nginx:alpine

RUN rm -f /etc/nginx/conf.d/default.conf

COPY --from=website-builder /build/website/dist   /usr/share/nginx/website
COPY --from=console-builder /build/console/dist   /usr/share/nginx/console
COPY --from=client-builder  /build/client/dist    /usr/share/nginx/client
COPY --from=driver-builder  /build/driver-h5/dist /usr/share/nginx/driver

COPY deploy/nginx/website.conf /etc/nginx/conf.d/website.conf
COPY deploy/nginx/console.conf /etc/nginx/conf.d/console.conf
COPY deploy/nginx/client.conf  /etc/nginx/conf.d/client.conf
COPY deploy/nginx/driver.conf  /etc/nginx/conf.d/driver.conf
COPY deploy/nginx/api.conf     /etc/nginx/conf.d/api.conf

RUN mkdir -p /var/www/certbot

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
