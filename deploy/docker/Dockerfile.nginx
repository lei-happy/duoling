# ============================================================
# 智途(ZhiTu) Nginx + 前端多阶段构建 Dockerfile
# 构建上下文: 项目根目录 (../..)
#
# 使用 BuildKit 时，三个前端构建阶段会自动并行执行
# DOCKER_BUILDKIT=1 docker build ...
# ============================================================

# ============================================================
# Stage 1: 构建产品官网 (www.zhitu.me)
# ============================================================
FROM node:20-alpine AS website-builder

ENV NODE_OPTIONS="--max-old-space-size=4096"
WORKDIR /build/website

# 安装依赖（利用 Docker 缓存）
COPY frontend/website/package.json frontend/website/package-lock.json* ./
RUN npm install --registry=https://registry.npmmirror.com

# 复制官网源码
COPY frontend/website/ .

# 复制共享组件到正确的相对路径（@shared/ -> ../components）
COPY frontend/components/ /build/components/

# 让共享组件能解析到 node_modules（向上查找到 /build/node_modules）
RUN ln -s /build/website/node_modules /build/node_modules

# 构建（显式设置堆内存上限）
RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build


# ============================================================
# Stage 2: 构建管理后台 (console.zhitu.me)
# ============================================================
FROM node:20-alpine AS console-builder

ENV NODE_OPTIONS="--max-old-space-size=4096"
WORKDIR /build/console

# 安装依赖
COPY frontend/console/package.json frontend/console/package-lock.json* ./
RUN npm install --registry=https://registry.npmmirror.com

# 复制管理后台源码（包含内置 components 目录，即 EleAdminPlus 组件库）
COPY frontend/console/ .

# 复制共享组件到正确的相对路径（@shared/ -> ../components）
COPY frontend/components/ /build/components/

# 让共享组件能解析到 node_modules（向上查找到 /build/node_modules）
RUN ln -s /build/console/node_modules /build/node_modules

# 使用 vite build 构建应用（显式设置堆内存上限）
RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build:app


# ============================================================
# Stage 3: 构建企业客户端 (wuliu.zhitu.me)
# ============================================================
FROM node:20-alpine AS client-builder

ENV NODE_OPTIONS="--max-old-space-size=4096"
WORKDIR /build/client

# 安装依赖
COPY frontend/client/package.json frontend/client/package-lock.json* ./
RUN npm install --registry=https://registry.npmmirror.com

# 复制客户端源码（包含内置 components 目录，即 EleAdminPlus 组件库）
COPY frontend/client/ .

# 复制共享组件到正确的相对路径（@shared/ -> ../components）
COPY frontend/components/ /build/components/

# 让共享组件能解析到 node_modules（向上查找到 /build/node_modules）
RUN ln -s /build/client/node_modules /build/node_modules

# 使用 vite build 构建应用（显式设置堆内存上限）
RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build:app


# ============================================================
# Stage 4: Nginx 生产镜像
# ============================================================
FROM nginx:alpine

# 移除默认配置
RUN rm -f /etc/nginx/conf.d/default.conf

# 复制各前端应用的构建产物到不同目录
COPY --from=website-builder /build/website/dist /usr/share/nginx/website
COPY --from=console-builder /build/console/dist /usr/share/nginx/console
COPY --from=client-builder  /build/client/dist  /usr/share/nginx/client

# 复制 Nginx 配置文件
COPY deploy/nginx/website.conf /etc/nginx/conf.d/website.conf
COPY deploy/nginx/console.conf /etc/nginx/conf.d/console.conf
COPY deploy/nginx/client.conf  /etc/nginx/conf.d/client.conf
COPY deploy/nginx/api.conf     /etc/nginx/conf.d/api.conf

# 创建 certbot webroot 目录（SSL 证书验证用）
RUN mkdir -p /var/www/certbot

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
