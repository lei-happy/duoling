.tx {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f3f8;
}

.tx:last-child {
  border-bottom: none;
}

.tx__t {
  font-size: 31rpx;
  font-weight: 500;
}

.tx__n {
  font-size: 31rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.pad {
  padding: 0 32rpx;
}
