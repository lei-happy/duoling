.balance-card {
  background: linear-gradient(145deg, #1d4ed8, #3b82f6);
  color: #fff;
}

.label {
  font-size: 26rpx;
  opacity: 0.9;
}

.balance {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.stats {
  display: flex;
  margin-top: 28rpx;
}

.stats > view {
  flex: 1;
}

.sub-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.sub-val {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.section-pad {
  padding: 24rpx 24rpx 8rpx;
}

.section-pad .section-title {
  margin-bottom: 0;
}

.loading-wrap,
.footer-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.loading-wrap {
  padding: 64rpx 0;
}
