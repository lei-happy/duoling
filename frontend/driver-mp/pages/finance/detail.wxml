<view class="page {{fontClass}}" wx:if="{{doc}}">
  <view class="card head">
    <view class="type">{{typeLabel}}</view>
    <view class="amount {{statusLevel === 'success' ? 'is-ok' : ''}}">¥{{amountText}}</view>
    <view class="tag tag--{{statusLevel === 'success' ? 'ok' : (statusLevel === 'warning' ? 'warn' : (statusLevel === 'info' ? 'info' : 'plain'))}} tag--lg">{{statusLabel}}</view>
  </view>

  <view class="card">
    <view class="kv"><text class="kv__k">单据编号</text><text class="kv__v">{{doc.docNo}}</text></view>
    <view class="kv"><text class="kv__k">关联任务</text><text class="kv__v">{{doc.taskNo || doc.taskId || '-'}}</text></view>
    <view class="kv"><text class="kv__k">收款人</text><text class="kv__v">{{doc.payeeName || '-'}}</text></view>
    <view class="kv"><text class="kv__k">支付方式</text><text class="kv__v">{{payMethodText}}</text></view>
    <view class="kv"><text class="kv__k">计划金额</text><text class="kv__v">¥{{plannedText}}</text></view>
    <view class="kv"><text class="kv__k">实付金额</text><text class="kv__v">¥{{actualText}}</text></view>
    <view class="kv"><text class="kv__k">计划付款</text><text class="kv__v">{{plannedPayText}}</text></view>
    <view class="kv"><text class="kv__k">实际付款</text><text class="kv__v">{{actualPayText}}</text></view>
    <view class="kv" wx:if="{{doc.remark}}"><text class="kv__k">备注</text><text class="kv__v">{{doc.remark}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">审批流转</view>
    <view class="timeline">
      <view class="tl" wx:for="{{flow}}" wx:key="title">
        <view class="tl__t">{{item.title}}</view>
        <view class="tl__s">{{item.sub}}</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{doc.items && doc.items.length}}">
    <view class="section-title">费用明细</view>
    <view class="item" wx:for="{{doc.items}}" wx:key="id">
      <view class="item-name">{{item.itemName || item.itemType}}</view>
      <view class="item-amt">¥{{item.amountText}}</view>
    </view>
  </view>
</view>
