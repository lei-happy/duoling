<view class="page" wx:if="{{doc}}">
  <view class="card head">
    <view class="row">
      <text class="doc-no">{{doc.docNo}}</text>
      <status-tag label="{{statusLabel}}" level="{{statusLevel}}" />
    </view>
    <view class="amount">¥{{amountText}}</view>
    <view class="meta">{{typeLabel}} · {{payMethodText}}</view>
  </view>

  <t-cell-group>
    <t-cell title="关联任务" note="{{doc.taskNo || doc.taskId || '-'}}" />
    <t-cell title="计划金额" note="¥{{plannedText}}" />
    <t-cell title="实付金额" note="¥{{actualText}}" />
    <t-cell title="计划付款" note="{{plannedPayText}}" />
    <t-cell title="实际付款" note="{{actualPayText}}" />
    <t-cell wx:if="{{doc.remark}}" title="备注" note="{{doc.remark}}" />
  </t-cell-group>

  <view class="card" wx:if="{{doc.items && doc.items.length}}">
    <view class="section-title">费用明细</view>
    <view class="item" wx:for="{{doc.items}}" wx:key="id">
      <view class="item-name">{{item.itemName || item.itemType}}</view>
      <view class="item-amt">¥{{item.amountText}}</view>
    </view>
  </view>
</view>
