<view class="page {{fontClass}}">
  <view class="wallethd">
    <view class="wallethd__l">可用余额（元）</view>
    <view class="wallethd__v"><small>¥</small>{{balanceText}}</view>
    <view class="wallethd__sp">
      <view><text class="k">累计入账</text><text class="v">{{totalInText}}</text></view>
      <view><text class="k">累计出账</text><text class="v">{{totalOutText}}</text></view>
      <view><text class="k">冻结</text><text class="v">{{frozenText}}</text></view>
    </view>
  </view>

  <view class="pad">
    <view class="sec-title"><text class="sec-title__h">流水记录</text></view>
  </view>

  <view class="loading-wrap" wx:if="{{loading && !list.length}}">
    <t-loading theme="circular" size="40rpx" text="正在加载，请稍候…" />
  </view>

  <empty-state wx:if="{{!loading && !list.length}}" text="暂无流水" hint="入账和出账会按时间记在这里。" />

  <view class="card card--plain" wx:if="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id" class="tx">
      <view>
        <view class="tx__t">{{item.bizLabel}}</view>
        <view class="meta">{{item.timeText}} · 余额 ¥{{item.balanceText}}</view>
      </view>
      <view class="tx__n">{{item.deltaText}}</view>
    </view>
  </view>

  <view class="footer-tip" wx:if="{{list.length}}">
    <t-loading wx:if="{{loadingMore}}" theme="circular" size="32rpx" text="加载中…" />
    <text wx:else>{{finished ? '没有更多了' : '上拉加载更多'}}</text>
  </view>
</view>
