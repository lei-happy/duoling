<view class="page">
  <view class="card balance-card">
    <view class="label">可用余额</view>
    <view class="balance">¥{{balanceText}}</view>
    <view class="stats">
      <view>
        <view class="sub-label">累计入账</view>
        <view class="sub-val">¥{{totalInText}}</view>
      </view>
      <view>
        <view class="sub-label">累计出账</view>
        <view class="sub-val">¥{{totalOutText}}</view>
      </view>
      <view>
        <view class="sub-label">冻结</view>
        <view class="sub-val">¥{{frozenText}}</view>
      </view>
    </view>
  </view>

  <view class="section-pad">
    <view class="section-title">流水记录</view>
  </view>

  <view class="loading-wrap" wx:if="{{loading && !list.length}}">
    <t-loading theme="circular" size="40rpx" text="正在加载，请稍候…" />
  </view>

  <empty-state wx:if="{{!loading && !list.length}}" text="暂无流水" />

  <t-cell-group wx:if="{{list.length}}">
    <t-cell
      wx:for="{{list}}"
      wx:key="id"
      title="{{item.bizLabel}}"
      description="{{item.timeText}} · 余额 ¥{{item.balanceText}}"
      note="{{item.deltaText}}"
    />
  </t-cell-group>

  <view class="footer-tip" wx:if="{{list.length}}">
    <t-loading wx:if="{{loadingMore}}" theme="circular" size="32rpx" text="加载中…" />
    <text wx:else>{{finished ? '没有更多了' : '上拉加载更多'}}</text>
  </view>
</view>
