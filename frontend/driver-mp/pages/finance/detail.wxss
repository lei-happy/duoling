.head .row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.doc-no {
  font-size: 32rpx;
  font-weight: 600;
}

.amount {
  margin-top: 20rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #0f172a;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.item:last-child {
  border-bottom: none;
}

.item-name {
  font-size: 28rpx;
}

.item-amt {
  font-size: 28rpx;
  font-weight: 600;
}
