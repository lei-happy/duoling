<view class="page {{fontClass}}">
  <view class="overcard stats-card">
    <view class="stats">
      <view class="stat">
        <text class="stat__v">{{totalIncomeText}}</text>
        <text class="stat__l">累计收入</text>
      </view>
      <view class="stat">
        <text class="stat__v">{{avgMonthText}}</text>
        <text class="stat__l">月均</text>
      </view>
    </view>
  </view>

  <view class="pad">
    <view class="sec-title"><text class="sec-title__h">按月收入</text></view>
  </view>
  <empty-state wx:if="{{!bars.length}}" text="暂无月度数据" />
  <view class="card" wx:if="{{bars.length}}">
    <view class="mbars">
      <view
        wx:for="{{bars}}"
        wx:key="month"
        class="mbars__col {{item.hi ? 'is-hi' : ''}}"
      >
        <text class="mbars__n">{{item.shortAmount}}</text>
        <view class="mbars__bar" style="height: {{item.h}}%;"></view>
        <text class="mbars__m">{{item.label}}</text>
      </view>
    </view>
  </view>
</view>
