.tabs-panel-hidden {
  display: none !important;
  height: 0 !important;
  min-height: 0 !important;
  overflow: hidden !important;
  padding: 0 !important;
}

.summary {
  margin: 24rpx;
  padding: 32rpx 8rpx 8rpx;
  background: linear-gradient(145deg, #1d4ed8, #3b82f6);
  border-radius: 24rpx;
  color: #fff;
  overflow: hidden;
}

.summary-title {
  padding: 0 20rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.summary-amount {
  padding: 0 20rpx;
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.summary-row {
  display: flex;
  margin-top: 28rpx;
  padding: 0 20rpx 24rpx;
}

.kpi {
  flex: 1;
}

.kpi-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.kpi-val {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.fund-entry {
  --td-cell-bg-color: transparent;
  --td-cell-title-color: #ffffff;
  --td-cell-right-icon-color: rgba(255, 255, 255, 0.85);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.finance-card {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
}

.row-1,
.row-2,
.row-3 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-1 {
  margin-bottom: 12rpx;
}

.doc-no {
  font-size: 30rpx;
  font-weight: 600;
}

.row-2 {
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.task-no {
  font-size: 24rpx;
  color: #94a3b8;
}

.amount-label {
  font-size: 24rpx;
  color: #94a3b8;
  margin-right: 8rpx;
}

.amount-val {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.time {
  font-size: 24rpx;
  color: #94a3b8;
}

.loading-wrap,
.footer-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.loading-wrap {
  padding: 64rpx 0;
}
