<view class="page">
  <view class="summary">
    <view class="summary-title">本月累计收入</view>
    <view class="summary-amount">¥ {{totalIncomeText}}</view>
    <view class="summary-row">
      <view class="kpi">
        <view class="kpi-label">预付</view>
        <view class="kpi-val">¥{{prepaidText}}</view>
      </view>
      <view class="kpi">
        <view class="kpi-label">补款</view>
        <view class="kpi-val">¥{{supplementText}}</view>
      </view>
      <view class="kpi">
        <view class="kpi-label">结算</view>
        <view class="kpi-val">¥{{settledText}}</view>
      </view>
    </view>
    <t-cell
      class="fund-entry"
      title="我的资金账户（往来账）"
      arrow
      bind:click="goFundAccount"
    />
  </view>

  <t-tabs
    value="{{docType}}"
    theme="tag"
    space-evenly="{{false}}"
    swipeable="{{false}}"
    t-class-content="tabs-panel-hidden"
    bind:change="onTabsChange"
  >
    <t-tab-panel
      wx:for="{{tabs}}"
      wx:key="name"
      label="{{item.title}}"
      value="{{item.name}}"
    />
  </t-tabs>

  <view class="loading-wrap" wx:if="{{loading && !list.length}}">
    <t-loading theme="circular" size="40rpx" text="正在加载，请稍候…" />
  </view>

  <empty-state wx:if="{{!loading && !list.length}}" text="暂无费用单" hint="有费用单据时会显示在这里" />

  <view
    class="finance-card"
    wx:for="{{list}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="row-1">
      <text class="doc-no">{{item.docNo}}</text>
      <status-tag label="{{item.statusLabel}}" level="{{item.statusLevel}}" />
    </view>
    <view class="row-2">
      <t-tag theme="primary" variant="light" size="small">{{item.typeLabel}}</t-tag>
      <text class="task-no">关联任务：{{item.taskNo || item.taskId}}</text>
    </view>
    <view class="row-3">
      <view class="amount">
        <text class="amount-label">实付</text>
        <text class="amount-val">¥{{item.amountText}}</text>
      </view>
      <text class="time">{{item.timeText}}</text>
    </view>
  </view>

  <view class="footer-tip" wx:if="{{list.length}}">
    <t-loading wx:if="{{loadingMore}}" theme="circular" size="32rpx" text="加载中…" />
    <text wx:else>{{finished ? '没有更多了' : '上拉加载更多'}}</text>
  </view>
</view>
