<view class="page page-flush {{fontClass}}">
  <view class="wallethd">
    <view class="wallethd__l">{{monthLabel}}累计收入（元）</view>
    <view class="wallethd__v"><small>¥</small>{{totalIncomeText}}</view>
    <view class="wallethd__sp">
      <view><text class="k">预付</text><text class="v">{{prepaidText}}</text></view>
      <view><text class="k">补款</text><text class="v">{{supplementText}}</text></view>
      <view><text class="k">结算</text><text class="v">{{settledText}}</text></view>
    </view>
  </view>

  <view class="pad income-pad">
    <mp-notice
      wx:if="{{unpaidText}}"
      title="还有 ¥{{unpaidText}} 没到账"
      desc="待审批和已审批、还没打到账上的费用单会算在这里。"
    />

    <view class="sec-title"><text class="sec-title__h">快捷</text></view>
    <view class="card card--plain">
      <mp-cell icon="fuel" tone="amber" title="资金账户与油卡" subtitle="往来账；油卡流水即将上线" bind:tap="goFund" />
      <mp-cell icon="chart" tone="green" title="收入汇总" subtitle="近几个月趋势" bind:tap="goSummary" />
      <mp-cell icon="card" title="我的收款账户" subtitle="{{accountHint}}" bind:tap="goAccount" />
    </view>

    <view class="sec-title">
      <text class="sec-title__h">费用单</text>
      <text class="sec-title__more" bindtap="goDocs">全部 ›</text>
    </view>
    <view class="loading-wrap" wx:if="{{loading && !preview.length}}">
      <t-loading theme="circular" size="40rpx" text="正在加载，请稍候…" />
    </view>
    <empty-state wx:if="{{!loading && !preview.length}}" text="还没有费用单" hint="预付、补款和结算单会按任务记在这里。" />
    <view class="card card--plain" wx:if="{{preview.length}}">
      <view wx:for="{{preview}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
        <mp-cell
          icon="{{item.icon}}"
          tone="{{item.tone}}"
          title="{{item.title}}"
          subtitle="{{item.subtitle}}"
          extra="{{item.amountText}}"
          extra-tone="{{item.extraTone}}"
        />
      </view>
    </view>
  </view>
</view>
