.head {
  background: linear-gradient(145deg, #1d4ed8, #3b82f6);
  color: #fff;
}

.label {
  font-size: 26rpx;
  opacity: 0.9;
}

.amount {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.row {
  display: flex;
  margin-top: 28rpx;
}

.row > view {
  flex: 1;
}

.sub-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.sub-val {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.section-pad {
  padding: 24rpx 24rpx 8rpx;
}

.section-pad .section-title {
  margin-bottom: 0;
}
