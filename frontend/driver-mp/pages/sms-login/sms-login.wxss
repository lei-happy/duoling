.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1d4ed8 0%, #1d4ed8 240rpx, #f4f6fb 240rpx);
  padding: 32rpx 0 40rpx;
}

.hero {
  padding: 32rpx 48rpx 24rpx;
  color: #fff;
}

.brand {
  font-size: 44rpx;
  font-weight: 700;
}

.slogan {
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.code-input {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 28rpx;
  margin: 0;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
}

.code-btn::after {
  border: none;
}

.code-btn[disabled] {
  color: #94a3b8;
  background: #f1f5f9;
}

.links {
  margin-top: 36rpx;
  text-align: center;
}

.link {
  color: #1d4ed8;
  font-size: 28rpx;
  padding: 12rpx 24rpx;
}
