.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1d4ed8 0%, #1d4ed8 240rpx, #f4f6fb 240rpx);
  padding: 32rpx 0 40rpx;
}

.hero {
  padding: 32rpx 48rpx 24rpx;
  color: #fff;
}

.brand {
  font-size: 44rpx;
  font-weight: 700;
}

.slogan {
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.code-btn {
  flex-shrink: 0;
  margin-bottom: 16rpx;
}

.links {
  margin-top: 36rpx;
  text-align: center;
}

.link {
  color: #1d4ed8;
  font-size: 28rpx;
  padding: 12rpx 24rpx;
}
