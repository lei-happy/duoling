<view class="page login-page">
  <view class="hero">
    <view class="brand">验证码登录</view>
    <view class="slogan">未设置密码或忘记密码时使用</view>
  </view>

  <view class="form card">
    <t-input
      label="手机号"
      type="number"
      maxlength="{{11}}"
      placeholder="请输入手机号"
      value="{{phone}}"
      layout="vertical"
      clearable
      bind:change="onPhone"
    />

    <view class="code-row">
      <t-input
        class="code-input"
        label="验证码"
        type="number"
        maxlength="{{6}}"
        placeholder="请输入验证码"
        value="{{code}}"
        layout="vertical"
        clearable
        bind:change="onCode"
      />
      <t-button
        class="code-btn"
        theme="primary"
        variant="light"
        size="large"
        disabled="{{countdown > 0 || sending}}"
        loading="{{sending}}"
        bind:tap="onSendCode"
      >{{countdown > 0 ? countdown + 's' : '获取验证码'}}</t-button>
    </view>

    <view class="form-actions">
      <t-button
        theme="primary"
        size="large"
        shape="round"
        block
        loading="{{loading}}"
        disabled="{{loading}}"
        bind:tap="onSubmit"
      >登录</t-button>
    </view>

    <view class="links">
      <text class="link" bindtap="goPassword">密码登录</text>
    </view>
  </view>
</view>
