<view class="auth">
  <view class="auth__hero">
    <view class="auth__status" style="height: {{statusBarHeight}}px;"></view>
    <view class="auth__nav">
      <view class="auth__back" bindtap="goPassword">
        <view class="auth__back-ico"></view>
      </view>
    </view>
    <view class="auth__brand">
      <view class="auth__mark">智</view>
      <view class="auth__title">验证码登录</view>
      <view class="auth__desc">
        <text>未设置密码或换过手机号时使用</text>
        <text>验证码发到你的手机</text>
      </view>
    </view>
    <view class="auth__road">
      <view class="auth__road-trap"></view>
      <view class="auth__road-dash auth__road-dash--1"></view>
      <view class="auth__road-dash auth__road-dash--2"></view>
      <view class="auth__road-dash auth__road-dash--3"></view>
    </view>
  </view>

  <view class="auth__panel">
    <view class="auth__field">
      <text class="auth__label">手机号</text>
      <input
        class="auth__input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="auth__input-placeholder"
        value="{{phone}}"
        bindinput="onPhone"
      />
    </view>

    <view class="auth__code-row">
      <view class="auth__field auth__code-field">
        <text class="auth__label">验证码</text>
        <input
          class="auth__input"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          placeholder-class="auth__input-placeholder"
          value="{{code}}"
          bindinput="onCode"
        />
      </view>
      <view
        class="auth__code-btn {{countdown > 0 || sending ? 'is-off' : ''}}"
        bindtap="onSendCode"
      >{{countdown > 0 ? countdown + 's' : (sending ? '发送中…' : '获取验证码')}}</view>
    </view>

    <view
      class="auth__submit {{agreed && !loading ? '' : 'is-off'}}"
      style="margin-top: 40rpx;"
      bindtap="onSubmit"
    >{{loading ? '正在登录，请稍候…' : '登录'}}</view>

    <view class="auth__agree" bindtap="onToggleAgree">
      <view class="auth__check {{agreed ? 'is-on' : ''}}">
        <view wx:if="{{agreed}}" class="auth__check-tick"></view>
      </view>
      <view class="auth__agree-text">
        已阅读并同意
        <text class="auth__link" catchtap="onOpenPolicy" data-key="service">服务协议</text>
        与
        <text class="auth__link" catchtap="onOpenPolicy" data-key="privacy">隐私政策</text>
      </view>
    </view>

    <view class="auth__alt">
      <text class="auth__alt-item" bindtap="goPassword">密码登录</text>
      <text class="auth__alt-item" bindtap="onHelp">登录遇到问题</text>
    </view>
  </view>
</view>

<view wx:if="{{policyVisible}}" class="auth__sheet-mask" bindtap="closePolicy" catchtouchmove="noop"></view>
<view wx:if="{{policyVisible}}" class="auth__sheet" catchtouchmove="noop">
  <view class="auth__sheet-title">{{policyTitle}}</view>
  <scroll-view scroll-y class="auth__sheet-body">
    <text>{{policyText}}</text>
  </scroll-view>
  <view class="auth__sheet-btn" bindtap="closePolicy">我知道了</view>
</view>
