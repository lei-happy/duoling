.home {
  padding-bottom: 32rpx;
}

.hero {
  background: linear-gradient(160deg, #1d4ed8 0%, #2563eb 55%, #3b82f6 100%);
  padding: 32rpx 28rpx 40rpx;
  color: #fff;
}

.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.hello {
  font-size: 40rpx;
  font-weight: 700;
}

.tenant {
  margin-top: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.switch {
  opacity: 0.9;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.kpi-row {
  display: flex;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 20rpx;
  padding: 24rpx 0;
}

.kpi {
  flex: 1;
  text-align: center;
  padding: 8rpx 4rpx;
}

.kpi-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.kpi-value.money {
  font-size: 28rpx;
}

.kpi-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.quick {
  display: flex;
  margin-top: -20rpx;
  padding: 28rpx 12rpx;
}

.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #334155;
  padding: 12rpx 0;
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.entry-icon.blue {
  background: #1d4ed8;
}

.entry-icon.green {
  background: #16a34a;
}

.entry-icon.orange {
  background: #f59e0b;
}

.entry-icon.gray {
  background: #64748b;
}
