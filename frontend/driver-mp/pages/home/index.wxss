.home {
  padding-bottom: 32rpx;
}

.hero {
  background: linear-gradient(160deg, #1d4ed8 0%, #2563eb 55%, #3b82f6 100%);
  padding: 32rpx 28rpx 40rpx;
  color: #fff;
}

.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.hello {
  font-size: 40rpx;
  font-weight: 700;
}

.tenant {
  margin-top: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.avatar {
  --td-avatar-bg-color: rgba(255, 255, 255, 0.22);
  --td-avatar-content-color: #ffffff;
}

.kpi-row {
  display: flex;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 20rpx;
  padding: 24rpx 0;
}

.kpi {
  flex: 1;
  text-align: center;
  padding: 8rpx 4rpx;
}

.kpi-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.kpi-value.money {
  font-size: 28rpx;
}

.kpi-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.quick {
  margin-top: -20rpx;
  padding: 12rpx 8rpx 20rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
}
