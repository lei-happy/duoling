.home {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.hd__row {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.hd__grow {
  flex: 1;
  min-width: 0;
}

.hd__hi {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.hd__org {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: rgba(206, 224, 255, 0.72);
}

.hd__caret {
  font-size: 20rpx;
}

.hd__bell {
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hd__bell-ico {
  width: 28rpx;
  height: 32rpx;
  border: 4rpx solid #fff;
  border-radius: 14rpx 14rpx 8rpx 8rpx;
}

.hd__strip {
  position: relative;
  margin-top: 30rpx;
  font-size: 25rpx;
  color: rgba(206, 224, 255, 0.72);
}

.mt-8 {
  margin-top: 16rpx;
}

.mt-12 {
  margin-top: 24rpx;
}

.mt-16 {
  margin-top: 32rpx;
}

.quick-card {
  margin: 0;
}

.quick {
  display: flex;
}

.quick__i {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: #0f172a;
}

.quick__i:active {
  transform: scale(0.93);
}

.quick__ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
}

.q1 {
  background: #eaf0ff;
}

.q2 {
  background: #fff5e3;
}

.q3 {
  background: #e7f6ec;
}

.q4 {
  background: #e4f4fd;
}

.pending-wrap + .pending-wrap {
  margin-top: 24rpx;
}

.idlecopy {
  margin-top: 24rpx;
}

.idlecopy__t {
  display: block;
  font-size: 32rpx;
  font-weight: 650;
  color: #0f172a;
}

.idlecopy__s {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #5a6779;
  line-height: 1.55;
}

.week-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.week-rest {
  color: #1d4ed8;
}

.sheet-desc {
  font-size: 26rpx;
  color: #5a6779;
  margin-bottom: 20rpx;
  line-height: 1.55;
}
