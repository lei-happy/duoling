<view class="page page-flush home {{fontClass}}">
  <view class="hd-hero home-hero" style="padding-top: {{padTop}}px; padding-bottom: 96rpx;">
    <view class="home-hero__fill"></view>
    <view class="home-wx" style="padding-right: {{padRight}}px;">
      <mp-icon name="pin" size="sm" color="rgba(255,255,255,0.88)" />
      <text>{{weather.strip}}</text>
    </view>
    <view class="home-who">
      <view class="home-who__main">
        <view class="home-who__line">
          <text class="home-who__name">{{displayName}}</text>
          <text wx:if="{{plateText}}" class="home-who__div"></text>
          <text wx:if="{{plateText}}" class="home-who__plate">{{plateText}}</text>
        </view>
        <view class="home-who__org" bindtap="goSwitchTenant">
          <text class="home-who__org-t">{{tenantName}}</text>
          <text class="home-who__caret">›</text>
        </view>
        <view class="home-who__limit">
          <mp-icon name="truck" size="sm" color="rgba(255,255,255,0.8)" />
          <text>{{weather.limit}}</text>
        </view>
      </view>
      <view class="home-av" bindtap="goProfile">
        <image wx:if="{{avatar}}" class="home-av__img" src="{{avatar}}" mode="aspectFill" />
        <view wx:else class="home-av__fallback">{{avatarText}}</view>
      </view>
    </view>
  </view>

  <view class="home-kpi">
    <view class="stat {{kpi.waitAccept ? 'is-amber' : ''}}" data-chip="waitAccept" bindtap="goTask">
      <text class="stat__v">{{kpi.waitAccept}}</text>
      <text class="stat__l">待接收</text>
    </view>
    <view class="stat" data-chip="waitLoad" bindtap="goTask">
      <text class="stat__v">{{kpi.waitLoad}}</text>
      <text class="stat__l">待装车</text>
    </view>
    <view class="stat" data-chip="3" bindtap="goTask">
      <text class="stat__v">{{kpi.inTransit}}</text>
      <text class="stat__l">在途中</text>
    </view>
    <view class="stat" data-chip="4" bindtap="goTask">
      <text class="stat__v">{{kpi.waitSign}}</text>
      <text class="stat__l">待签收</text>
    </view>
  </view>

  <view class="home-body">
    <workbench-task-card
      wx:if="{{running}}"
      view="{{running}}"
      bind:tap="onTaskTap"
      bind:action="onCardAction"
    />

    <ticket-card wx:if="{{!running}}" idle show-road>
      <view slot="idle" class="idlecopy">
        <text class="idlecopy__t">这会儿没有要跑的单</text>
        <text class="idlecopy__s">调度派车后会立刻出现在这里，不用一直进来刷。</text>
        <view class="btn btn--ghost btn--sm idlecopy__btn" bindtap="onCallDispatch">
          <mp-icon name="phone" size="sm" />
          联系调度 李敏
        </view>
      </view>
    </ticket-card>

    <view class="home-card home-quick">
      <text class="home-card__h">常用操作</text>
      <view class="quick">
        <view class="quick__i" bindtap="onReceipt">
          <view class="quick__ico q1">
            <mp-icon name="camera" size="lg" color="#ffffff" />
          </view>
          <text>上传回单</text>
        </view>
        <view class="quick__i" bindtap="goFuel">
          <view class="quick__ico q2">
            <mp-icon name="fuel" size="lg" color="#ffffff" />
          </view>
          <text>油卡加油</text>
        </view>
        <view class="quick__i" bindtap="goFinance">
          <view class="quick__ico q3">
            <mp-icon name="wallet" size="lg" color="#ffffff" />
          </view>
          <text>我的收入</text>
        </view>
        <view class="quick__i" bindtap="openExcp">
          <view class="quick__ico q4">
            <mp-icon name="warn" size="lg" color="#ffffff" />
          </view>
          <text>异常上报</text>
        </view>
      </view>
    </view>

    <block wx:if="{{pending.length}}">
      <view class="home-sec">
        <text class="home-sec__h">待处理任务</text>
        <text class="home-sec__n">{{pending.length}} 条</text>
      </view>
      <view wx:for="{{pending}}" wx:key="id" class="home-pending">
        <workbench-task-card
          view="{{item}}"
          bind:tap="onTaskTap"
          bind:action="onCardAction"
        />
      </view>
    </block>

    <view wx:if="{{receiptHint}}" class="home-receipt" bindtap="goReceiptHint">
      <view class="home-receipt__ico">
        <mp-icon name="warn" size="sm" color="#ef7c00" />
      </view>
      <view class="home-receipt__txt">
        <text class="home-receipt__t">{{receiptHint.title}}</text>
        <text class="home-receipt__d">{{receiptHint.desc}}</text>
      </view>
      <view class="home-receipt__btn" catchtap="goReceiptHint">补传</view>
    </view>

    <view class="home-card home-week">
      <view class="home-week__hd">
        <text class="home-card__h">本周排班</text>
        <text class="home-week__range">{{week.rangeText}}</text>
      </view>
      <view class="minical">
        <view
          wx:for="{{week.days}}"
          wx:key="key"
          class="minical__d {{item.on ? 'is-on' : ''}} {{item.has ? 'is-has' : ''}}"
        >
          <text class="minical__w">{{item.week}}</text>
          <text class="minical__n">{{item.date}}</text>
        </view>
      </view>
      <view class="week-foot">
        <text>本周已跑 {{week.tripCount}} 趟 · 累计 {{week.kmText}} 公里</text>
        <text wx:if="{{week.sundayRest}}" class="week-rest">周日休息</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet"></view>

<view wx:if="{{sheet === 'reject'}}" class="sheet">
  <view class="sheet__grab"></view>
  <view class="sheet__title">拒绝调令</view>
  <view class="sheet-desc">拒单后，这单会退回调度重新派。请写清楚原因。</view>
  <view class="chips">
    <view
      wx:for="{{rejectReasons}}"
      wx:key="*this"
      class="chip {{rejectPick === item ? 'is-on' : ''}}"
      data-v="{{item}}"
      bindtap="pickReject"
    >{{item}}</view>
  </view>
  <t-textarea
    placeholder="请填写拒单原因（必填）"
    value="{{rejectReason}}"
    maxlength="{{255}}"
    indicator
    bind:change="onRejectReason"
  />
  <view class="btnrow mt-16">
    <view class="btn btn--ghost" bindtap="closeSheet">先不拒</view>
    <view class="btn btn--danger" bindtap="submitReject">确认拒绝</view>
  </view>
</view>
