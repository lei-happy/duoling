<view class="page home">
  <view class="hero">
    <view class="hero-row">
      <view class="hello-block">
        <view class="hello">您好，{{realName}}</view>
        <view class="tenant" bindtap="goSwitchTenant">
          <text class="tenant-name">{{tenantName}}</text>
          <t-icon name="swap" size="28rpx" color="#ffffff" />
        </view>
      </view>
      <t-avatar size="96rpx" class="avatar">{{avatarText}}</t-avatar>
    </view>

    <view class="kpi-row">
      <view class="kpi" data-status="1" bindtap="goTask">
        <view class="kpi-value">{{kpi.waitLoad}}</view>
        <view class="kpi-label">待装车</view>
      </view>
      <view class="kpi" data-status="3" bindtap="goTask">
        <view class="kpi-value">{{kpi.inTransit}}</view>
        <view class="kpi-label">在途</view>
      </view>
      <view class="kpi" data-status="4" bindtap="goTask">
        <view class="kpi-value">{{kpi.waitSign}}</view>
        <view class="kpi-label">待签收</view>
      </view>
      <view class="kpi" bindtap="goFinance">
        <view class="kpi-value money">¥{{monthlyIncomeText}}</view>
        <view class="kpi-label">本月收入</view>
      </view>
    </view>
  </view>

  <view class="quick card">
    <t-grid column="{{4}}" border="{{false}}">
      <t-grid-item text="我的任务" icon="view-list" data-status="" bind:click="goTask" />
      <t-grid-item text="我的收入" icon="wallet" bind:click="goFinance" />
      <t-grid-item text="收款账户" icon="card" bind:click="goSummary" />
      <t-grid-item text="个人中心" icon="user" bind:click="goProfile" />
    </t-grid>
  </view>

  <section-header title="近期任务" more="全部" bind:more="goTaskAll" />
  <view class="loading-wrap" wx:if="{{loading && !recent.length}}">
    <t-loading theme="circular" size="40rpx" text="正在加载，请稍候…" />
  </view>
  <empty-state wx:if="{{!loading && !recent.length}}" text="暂无任务" hint="有新任务时会显示在这里" />
  <task-card
    wx:for="{{recent}}"
    wx:key="id"
    task="{{item}}"
    bind:tap="onTaskTap"
  />
</view>
