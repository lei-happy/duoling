<view class="page login-page">
  <view class="hero">
    <view class="brand">智途司机</view>
    <view class="slogan">任务进度一手掌握</view>
  </view>

  <view class="form card">
    <t-input
      label="手机号"
      type="number"
      maxlength="{{11}}"
      placeholder="请输入手机号"
      value="{{phone}}"
      layout="vertical"
      clearable
      bind:change="onPhone"
    />
    <t-input
      label="密码"
      type="password"
      placeholder="请输入密码"
      value="{{password}}"
      layout="vertical"
      clearable
      bind:change="onPassword"
    />

    <view class="form-actions">
      <t-button
        theme="primary"
        size="large"
        shape="round"
        block
        loading="{{loading}}"
        disabled="{{loading}}"
        bind:tap="onSubmit"
      >登录</t-button>
    </view>

    <view class="links">
      <text class="link" bindtap="goSms">验证码登录</text>
      <text class="hint">忘记密码？请用验证码登录后修改</text>
    </view>
  </view>
</view>
