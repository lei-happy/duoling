.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1d4ed8 0%, #1d4ed8 280rpx, #f4f6fb 280rpx);
  padding: 48rpx 0 40rpx;
}

.hero {
  padding: 48rpx 48rpx 40rpx;
  color: #fff;
}

.brand {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.slogan {
  margin-top: 12rpx;
  font-size: 28rpx;
  opacity: 0.85;
}

.form {
  margin-top: 8rpx;
}

.links {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.link {
  color: #1d4ed8;
  font-size: 28rpx;
  font-weight: 500;
  padding: 12rpx 24rpx;
}

.hint {
  font-size: 24rpx;
  color: #94a3b8;
}
