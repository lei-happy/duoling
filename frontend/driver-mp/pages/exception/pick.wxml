<view class="page {{fontClass}}">
  <view class="pad">
    <view class="sos" bindtap="openSos">
      <view class="sos__ico">
        <mp-icon name="phone" size="lg" color="#ffffff" />
      </view>
      <view class="grow">
        <view class="sos__t">出事了？先打电话</view>
        <view class="sos__s">一键呼叫调度 李敏 · 安全员 陈刚</view>
      </view>
      <text>›</text>
    </view>

    <view class="sec-title">
      <text class="sec-title__h">发生了什么</text>
      <text class="sec-title__n">选一类，只填必要的</text>
    </view>
    <view class="types">
      <view wx:for="{{types}}" wx:key="key" class="type type--{{item.tone}}" data-key="{{item.key}}" bindtap="goForm">
        <view class="type__ico">
          <mp-icon name="{{item.icon}}" size="lg" />
        </view>
        <text class="type__t">{{item.title}}</text>
        <text class="type__s">{{item.desc}}</text>
      </view>
    </view>

    <view class="sec-title">
      <text class="sec-title__h">我报过的</text>
      <text class="sec-title__n">近 30 天 {{history.length}} 条</text>
    </view>
    <view class="card card--plain">
      <view wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="goTrack">
        <mp-cell
          icon="{{item.icon}}"
          tone="{{item.status === '已处理' ? 'green' : 'amber'}}"
          title="{{item.title}}"
          subtitle="{{item.taskNo}} · {{item.time}} 上报"
          extra="{{item.status}}"
        />
      </view>
    </view>
    <view class="center-cap">上报后调度会立刻看到，客户那边由调度去说，你专心开车</view>
  </view>
</view>

<view wx:if="{{sheet === 'sos'}}" class="sheet-mask" bindtap="closeSheet"></view>
<view wx:if="{{sheet === 'sos'}}" class="sheet">
  <view class="sheet__grab"></view>
  <view class="sheet__title">先打电话</view>
  <view class="sheet-item" data-who="dispatch" bindtap="callWho">
    <mp-icon name="phone" size="md" color="#1d4ed8" />
    <text>调度 李敏</text>
  </view>
  <view class="sheet-item" data-who="safety" bindtap="callWho">
    <mp-icon name="phone" size="md" color="#1d4ed8" />
    <text>安全员 陈刚</text>
  </view>
  <view class="sheet-item" data-who="rescue" bindtap="callWho">
    <mp-icon name="phone" size="md" color="#1d4ed8" />
    <text>公司救援</text>
  </view>
  <view class="sheet-item" data-who="122" bindtap="callWho">
    <mp-icon name="warn" size="md" color="#dc2626" />
    <text>报警 122</text>
  </view>
  <view class="btn btn--ghost btn--block" bindtap="closeSheet">取消</view>
</view>
