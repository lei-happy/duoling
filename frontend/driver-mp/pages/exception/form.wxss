.cell-t { font-size: 30rpx; font-weight: 600; }
.meta { margin-top: 8rpx; font-size: 24rpx; color: #94a3b8; }
.grow { flex: 1; }
.actionbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.06);
}
.page-with-action { padding-bottom: 160rpx; }
