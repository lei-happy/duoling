<view class="page tenant-page">
  <view class="tenant-head">
    <view class="tenant-h1">你在 {{tenants.length}} 家企业有司机身份</view>
    <view class="tenant-cap">选一家进入。之后可以在「我的」里随时切换，任务和收入分开算。</view>
  </view>

  <view
    wx:for="{{tenants}}"
    wx:key="tenantCode"
    class="tenant {{item.tenantCode === selectedCode ? 'is-on' : ''}}"
    data-code="{{item.tenantCode}}"
    bindtap="onPick"
  >
    <view class="tenant__logo" style="background: {{item.logoBg}};">{{item.initial}}</view>
    <view class="tenant__main">
      <view class="tenant__name">{{item.tenantName || item.tenantCode}}</view>
      <view class="tenant__sub">企业编码 {{item.tenantCode}}</view>
    </view>
    <view wx:if="{{item.tenantCode === selectedCode}}" class="tenant__tag">当前</view>
    <view wx:else class="tenant__arrow"></view>
  </view>

  <empty-state
    wx:if="{{!tenants.length && !loading}}"
    text="暂无可选企业"
    hint="请联系企业调度员，在「运力中心 → 驾驶员管理」添加你"
  />

  <view class="tenant-help">
    <view class="tenant-help__title">没找到你的企业？</view>
    <view class="tenant-help__card">
      <view class="tenant-help__ico">调</view>
      <view class="tenant-help__main">
        <view class="tenant-help__name">联系调度员添加</view>
        <view class="tenant-help__desc">让他在「运力中心」把你加进驾驶员名单，加好后重新登录就能看到</view>
      </view>
    </view>
  </view>

  <view class="tenant-bar safe-bottom" wx:if="{{tenants.length}}">
    <view
      class="tenant-enter {{selectedCode && !loading ? '' : 'is-off'}}"
      bindtap="onEnter"
    >{{loading ? '正在进入企业，请稍候…' : (enterLabel || '请先选择企业')}}</view>
  </view>
</view>
