.tip-title {
  font-size: 26rpx;
  color: #64748b;
}

.current {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.tenant-list {
  padding: 0 24rpx;
}

.tenant-item {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.tenant-item.active {
  border-color: #1d4ed8;
  background: #eff6ff;
}

.tenant-name {
  font-size: 32rpx;
  font-weight: 600;
  padding-right: 100rpx;
}

.tenant-code {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.badge {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 600;
}
