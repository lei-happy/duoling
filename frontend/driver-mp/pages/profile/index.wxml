<view class="page profile">
  <view class="user-card">
    <view class="user-row">
      <t-avatar size="100rpx" class="avatar">{{avatarText}}</t-avatar>
      <view class="user-info">
        <view class="name">{{realName}}</view>
        <view class="phone">{{phoneMasked}}</view>
      </view>
    </view>
    <view class="tenant">当前企业：{{tenantName}}</view>
  </view>

  <t-cell-group>
    <t-cell title="个人信息" left-icon="user" arrow bind:click="goInfo" />
    <t-cell title="切换企业" left-icon="swap" arrow bind:click="goSwitchTenant" />
    <t-cell title="修改密码" left-icon="lock-on" arrow bind:click="goChangePassword" />
  </t-cell-group>

  <view class="group-gap"></view>

  <t-cell-group>
    <t-cell title="收入汇总" left-icon="chart-bar" arrow bind:click="goSummary" />
    <t-cell title="收款账户" left-icon="card" arrow bind:click="goSummary" />
  </t-cell-group>

  <view class="group-gap"></view>

  <t-cell-group>
    <t-cell title="关于" left-icon="info-circle" arrow bind:click="onAbout" />
  </t-cell-group>

  <view class="logout-wrap">
    <t-button theme="danger" variant="outline" size="large" shape="round" block bind:tap="onLogout">
      退出登录
    </t-button>
  </view>
</view>
