.head { text-align: center; }
.gold { font-size: 40rpx; font-weight: 700; color: #b26b00; }
.meta { margin-top: 8rpx; font-size: 24rpx; color: #94a3b8; }
.overcard { margin: 0 0 8rpx; }
.kpi + .kpi { margin-top: 24rpx; }
.kpi-h { display: flex; justify-content: space-between; font-size: 27rpx; }
