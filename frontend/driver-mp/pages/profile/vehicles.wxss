.rig__u + .rig__u { margin-top: 24rpx; }
.rig__l { font-size: 24rpx; color: #94a3b8; display: block; margin-bottom: 8rpx; }
.gauge { display: flex; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx dashed #e7ebf3; }
.gauge view { flex: 1; text-align: center; }
.g-v { display: block; font-size: 36rpx; font-weight: 700; }
.g-l { display: block; margin-top: 6rpx; font-size: 22rpx; color: #94a3b8; }
.lic { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f0f3f8; }
.lic:last-child { border-bottom: none; }
.lic-t { font-size: 29rpx; font-weight: 600; }
.meta { margin-top: 6rpx; font-size: 23rpx; color: #94a3b8; }
.grow { flex: 1; }
.actionbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.page-with-action { padding-bottom: 160rpx; }
.mt-16 { margin-top: 32rpx; }
