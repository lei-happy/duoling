.user-card {
  margin: 24rpx;
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #1d4ed8, #3b82f6);
  color: #fff;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
}

.phone {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.tenant {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 26rpx;
  opacity: 0.92;
}

.logout-wrap {
  margin: 48rpx 24rpx;
}

.logout-wrap .btn-ghost {
  background: #fff;
  color: #dc2626;
  border-color: #fecaca;
  display: flex;
  align-items: center;
  justify-content: center;
}
