.user-card {
  margin: 24rpx;
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #1d4ed8, #3b82f6);
  color: #fff;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  --td-avatar-bg-color: rgba(255, 255, 255, 0.22);
  --td-avatar-content-color: #ffffff;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
}

.phone {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.tenant {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 26rpx;
  opacity: 0.92;
}

.group-gap {
  height: 16rpx;
}

.logout-wrap {
  margin: 48rpx 24rpx;
}
