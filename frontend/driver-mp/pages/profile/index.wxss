.prof__r {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.prof__av {
  width: 116rpx;
  height: 116rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  font-size: 42rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.prof__grow {
  flex: 1;
  min-width: 0;
}

.prof__n {
  font-size: 44rpx;
  font-weight: 650;
}

.prof__s {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: rgba(206, 224, 255, 0.72);
}

.prof__arr {
  font-size: 40rpx;
  color: rgba(206, 224, 255, 0.6);
}

.honor-card {
  padding: 28rpx 8rpx 20rpx;
}

.coming--tight {
  padding: 12rpx 16rpx 4rpx;
}

.ver {
  text-align: center;
  margin: 40rpx 0 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.faq {
  margin-bottom: 24rpx;
}

.faq__q {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.faq__a {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #5a6779;
  line-height: 1.55;
}
