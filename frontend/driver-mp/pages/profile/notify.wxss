.subrow {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f3f8;
}
.subrow:last-child { border-bottom: none; }
.sub-t { font-size: 30rpx; font-weight: 600; }
.meta { margin-top: 6rpx; font-size: 24rpx; color: #94a3b8; line-height: 1.5; }
.grow { flex: 1; }
