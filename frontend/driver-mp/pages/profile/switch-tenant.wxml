<view class="page {{fontClass}}">
  <view class="pad">
    <mp-notice
      theme="info"
      title="任务和收入按企业分开算"
      desc="切换后看到的都是那家公司的数据，不会串。"
    />
  </view>

  <view class="loading-wrap" wx:if="{{loading && !tenants.length}}">
    <t-loading theme="circular" size="40rpx" text="正在加载，请稍候…" />
  </view>

  <view class="card card--plain" wx:if="{{tenants.length}}">
    <view
      wx:for="{{tenants}}"
      wx:key="tenantCode"
      data-code="{{item.tenantCode}}"
      bindtap="onSelect"
    >
      <mp-cell
        initial="{{item.initial}}"
        title="{{item.tenantName || item.tenantCode}}"
        subtitle="{{item.tenantCode}}"
        extra="{{item.tenantCode === currentCode ? '当前' : '切换'}}"
        arrow="{{item.tenantCode !== currentCode}}"
      />
    </view>
  </view>

  <empty-state wx:if="{{!loading && !tenants.length}}" text="暂无其他企业" hint="需要加入新企业时，请联系调度拿邀请。" />
</view>
