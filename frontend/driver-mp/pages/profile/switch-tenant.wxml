<view class="page">
  <view class="tip card">
    <view class="tip-title">当前企业</view>
    <view class="current">{{currentName || currentCode || '-'}}</view>
  </view>

  <view class="tenant-list">
    <view
      class="tenant-item {{item.tenantCode === currentCode ? 'active' : ''}}"
      wx:for="{{tenants}}"
      wx:key="tenantCode"
      data-code="{{item.tenantCode}}"
      bindtap="onSelect"
    >
      <view class="tenant-name">{{item.tenantName || item.tenantCode}}</view>
      <view class="tenant-code">{{item.tenantCode}}</view>
      <view wx:if="{{item.tenantCode === currentCode}}" class="badge">当前</view>
    </view>
  </view>

  <empty-state wx:if="{{!loading && !tenants.length}}" text="暂无其他企业" />
</view>
