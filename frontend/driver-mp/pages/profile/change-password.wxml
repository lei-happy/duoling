<view class="page">
  <view class="tip card" wx:if="{{force}}">
    <view class="tip-title">首次登录请修改密码</view>
    <view class="tip-desc">为保障账号安全，请设置新密码后再使用</view>
  </view>

  <view class="form card">
    <view class="form-group">
      <view class="form-label">原密码</view>
      <input class="form-input" password placeholder="请输入原密码" value="{{oldPassword}}" bindinput="onOld" />
    </view>
    <view class="form-group">
      <view class="form-label">新密码</view>
      <input class="form-input" password placeholder="至少 6 位" value="{{newPassword}}" bindinput="onNew" />
    </view>
    <view class="form-group">
      <view class="form-label">确认新密码</view>
      <input class="form-input" password placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirm" />
    </view>
    <button class="btn-primary btn-block" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">
      确认修改
    </button>
  </view>
</view>
