<view class="page">
  <t-notice-bar
    wx:if="{{force}}"
    visible="{{true}}"
    theme="warning"
    content="首次登录请修改密码，设置完成后再使用"
  />

  <view class="form card">
    <t-input
      label="原密码"
      type="password"
      placeholder="请输入原密码"
      value="{{oldPassword}}"
      layout="vertical"
      clearable
      bind:change="onOld"
    />
    <t-input
      label="新密码"
      type="password"
      placeholder="至少 6 位"
      value="{{newPassword}}"
      layout="vertical"
      clearable
      bind:change="onNew"
    />
    <t-input
      label="确认新密码"
      type="password"
      placeholder="请再次输入新密码"
      value="{{confirmPassword}}"
      layout="vertical"
      clearable
      bind:change="onConfirm"
    />
    <view class="form-actions">
      <t-button
        theme="primary"
        size="large"
        shape="round"
        block
        loading="{{loading}}"
        disabled="{{loading}}"
        bind:tap="onSubmit"
      >确认修改</t-button>
    </view>
  </view>
</view>
