.ttl { font-size: 36rpx; font-weight: 650; }
.meta { margin: 10rpx 0 8rpx; font-size: 24rpx; color: #94a3b8; }
.body { margin-top: 16rpx; font-size: 28rpx; color: #5a6779; line-height: 1.6; }
.actionbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.grow { flex: 1; }
.page-with-action { padding-bottom: 160rpx; }
