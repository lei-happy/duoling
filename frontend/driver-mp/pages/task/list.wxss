.sticky {
  position: sticky;
  top: 0;
  z-index: 12;
  background: rgba(244, 246, 251, 0.94);
  padding: 16rpx 0 12rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx 16rpx;
}

.searchbar {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background: #eaeef6;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}

.searchbar__input {
  flex: 1;
  font-size: 29rpx;
}

.filter-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: inset 0 0 0 2rpx #e7ebf3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #5a6779;
}

.filter-btn.is-on {
  background: #eaf0ff;
  color: #1d4ed8;
  box-shadow: inset 0 0 0 2rpx #1d4ed8;
}

.group {
  padding: 0 32rpx;
}

.swipe {
  position: relative;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 32rpx;
}

.swipe__acts {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 304rpx;
  display: flex;
}

.a-primary,
.a-grey {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.a-primary {
  background: #1d4ed8;
}

.a-grey {
  background: #64748b;
}

.swipe__body {
  position: relative;
  background: #f4f6fb;
  transition: transform 0.2s ease;
}

.card-actions {
  margin-top: 16rpx;
}

.empty-box {
  padding-top: 80rpx;
}

.field-l {
  margin: 28rpx 0 12rpx;
  font-size: 26rpx;
  color: #5a6779;
}

.mt-16 {
  margin-top: 32rpx;
}

.sheet-desc {
  font-size: 26rpx;
  color: #5a6779;
  margin-bottom: 20rpx;
  line-height: 1.55;
}

chip-bar {
  display: block;
  padding: 0 32rpx;
}
