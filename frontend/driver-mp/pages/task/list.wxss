.tabs-panel-hidden {
  display: none !important;
  height: 0 !important;
  min-height: 0 !important;
  overflow: hidden !important;
  padding: 0 !important;
}

.search-wrap {
  margin: 8rpx 0 0;
  background: #fff;
  padding: 8rpx 0;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 64rpx 0;
}

.footer-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
}
