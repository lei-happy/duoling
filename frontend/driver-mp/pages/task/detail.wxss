.detail-ticket {
  padding-top: 24rpx;
}

.status-banner {
  padding: 36rpx 32rpx;
  color: #fff;
}

.status-banner.level-primary,
.status-banner.level-info {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
}

.status-banner.level-warning {
  background: linear-gradient(135deg, #d97706, #f59e0b);
}

.status-banner.level-success {
  background: linear-gradient(135deg, #15803d, #16a34a);
}

.status-banner.level-danger {
  background: linear-gradient(135deg, #b91c1c, #dc2626);
}

.status-banner.level-default {
  background: linear-gradient(135deg, #64748b, #94a3b8);
}

.status-label {
  font-size: 44rpx;
  font-weight: 700;
}

.task-name {
  margin-top: 8rpx;
  font-size: 30rpx;
  opacity: 0.95;
}

.task-no {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.route-line {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 0;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.dot.from {
  background: #1d4ed8;
}

.dot.to {
  background: #16a34a;
}

.loc {
  font-size: 32rpx;
  font-weight: 600;
}

.time {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.item-row:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.brand {
  font-size: 28rpx;
  font-weight: 600;
}

.sign-btn {
  flex-shrink: 0;
}

.segment-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
}

.seg-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #1d4ed8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.seg-info {
  flex: 1;
  font-size: 28rpx;
}

.finance-row {
  display: flex;
  margin-bottom: 8rpx;
}

.finance-row > view {
  flex: 1;
}

.finance-row .label {
  font-size: 24rpx;
  color: #94a3b8;
}

.finance-row .amount {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.loading-wrap {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-body {
  text-align: left;
}

.dialog-msg {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.photo-block {
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}
