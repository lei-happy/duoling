.status-banner {
  padding: 36rpx 32rpx;
  color: #fff;
}

.status-banner.level-primary,
.status-banner.level-info {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
}

.status-banner.level-warning {
  background: linear-gradient(135deg, #d97706, #f59e0b);
}

.status-banner.level-success {
  background: linear-gradient(135deg, #15803d, #16a34a);
}

.status-banner.level-danger {
  background: linear-gradient(135deg, #b91c1c, #dc2626);
}

.status-banner.level-default {
  background: linear-gradient(135deg, #64748b, #94a3b8);
}

.status-label {
  font-size: 44rpx;
  font-weight: 700;
}

.task-name {
  margin-top: 8rpx;
  font-size: 30rpx;
  opacity: 0.95;
}

.task-no {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.route-line {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 0;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.dot.from {
  background: #1d4ed8;
}

.dot.to {
  background: #16a34a;
}

.loc {
  font-size: 32rpx;
  font-weight: 600;
}

.time {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.item-row:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.brand {
  font-size: 28rpx;
  font-weight: 600;
}

.sign-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  margin: 0;
  background: #16a34a;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: none;
}

.sign-btn::after {
  border: none;
}

.segment-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
}

.seg-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cell.link {
  padding: 8rpx 0;
}

.finance-row {
  display: flex;
  gap: 48rpx;
  margin-bottom: 16rpx;
}

.finance-row .label {
  font-size: 24rpx;
  color: #94a3b8;
}

.finance-row .amount {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.loading-wrap {
  padding: 120rpx;
  text-align: center;
  color: #94a3b8;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.dialog {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
}

.dialog-msg {
  margin: 16rpx 0 24rpx;
  font-size: 26rpx;
  color: #64748b;
}

.photo-block {
  margin-bottom: 20rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.photo-item,
.photo-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  text-align: center;
  line-height: 44rpx;
  font-size: 28rpx;
}

.photo-add {
  border: 2rpx dashed #cbd5e1;
  color: #94a3b8;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.dialog-actions button {
  flex: 1;
}
