<view class="page page-with-action">
  <view class="card">
    <view class="section-title">回单图片（最多 9 张）</view>
    <t-upload
      files="{{fileList}}"
      media-type="{{mediaType}}"
      max="{{9}}"
      request-method="{{uploadReceiptPhotos}}"
      bind:success="onUploadSuccess"
      bind:remove="onUploadRemove"
      bind:fail="onUploadFail"
    />
  </view>

  <view class="card">
    <view class="section-title">备注</view>
    <t-textarea
      placeholder="备注（选填）"
      maxlength="{{255}}"
      value="{{remark}}"
      indicator
      bind:change="onRemark"
    />
  </view>

  <view class="card" wx:if="{{receipts.length}}">
    <view class="section-title">已上传回单（{{receipts.length}}）</view>
    <view class="history" wx:for="{{receipts}}" wx:key="id">
      <view class="history-imgs">
        <view
          class="history-img-wrap"
          wx:for="{{item.displayUrls}}"
          wx:for-item="u"
          wx:key="*this"
          data-urls="{{item.displayUrls}}"
          data-current="{{u}}"
          bindtap="previewHistory"
        >
          <t-image src="{{u}}" mode="aspectFill" shape="round" class="history-img" />
        </view>
      </view>
      <t-button
        theme="danger"
        variant="text"
        size="small"
        data-id="{{item.id}}"
        bind:tap="onDelete"
      >删除</t-button>
    </view>
  </view>

  <bottom-action-bar
    actions="{{submitActions}}"
    loading="{{submitting}}"
    current-key="submit"
    bind:action="onSubmit"
  />
</view>
