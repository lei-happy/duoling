<view class="page page-with-action" wx:if="{{task}}">
  <view class="sthd">
    <view class="sthd__no">{{task.taskNo}}</view>
    <view class="sthd__st">{{statusInfo.label}}</view>
    <view class="sthd__route">
      <view class="sthd__place">
        <text wx:if="{{ticketView.origin.province}}" class="sthd__prov">{{ticketView.origin.province}}</text>
        <text class="sthd__city">{{ticketView.origin.title}}</text>
      </view>
      <view class="sthd__dash"></view>
      <view class="sthd__place is-right">
        <text wx:if="{{ticketView.destination.province}}" class="sthd__prov">{{ticketView.destination.province}}</text>
        <text class="sthd__city">{{ticketView.destination.title}}</text>
      </view>
    </view>
    <road-progress
      theme="dark"
      percent="{{ticketView.roadPercent}}"
      stops="{{ticketView.roadStops}}"
      parked="{{ticketView.status < 2}}"
    />
    <view class="sthd__meta">{{itemCount}} 行 / {{task.totalQuantity || 0}} 台 · 要求 {{plannedArriveText}} 前到货</view>
  </view>

  <view class="card">
    <view class="section-title">货物明细（{{itemCount}} 行 / {{task.totalQuantity || 0}} 台）</view>
    <view class="item-row" wx:for="{{itemsView}}" wx:key="id">
      <view class="item-main">
        <view class="item-line">
          <text class="brand">{{item.brandText}}</text>
          <status-tag label="{{item.statusLabel}}" level="{{item.statusLevel}}" />
        </view>
        <view class="item-line meta">{{item.metaText}}</view>
        <view class="item-line meta" wx:if="{{item.dealerName}}">{{item.dealerName}}</view>
      </view>
      <t-button
        wx:if="{{task.status === 4 && item.status < 3}}"
        class="sign-btn"
        theme="primary"
        size="small"
        shape="round"
        loading="{{acting}}"
        data-id="{{item.id}}"
        bind:tap="onSignItem"
      >签收</t-button>
    </view>
  </view>

  <view class="card" wx:if="{{task.segments && task.segments.length}}">
    <view class="section-title">运输分段</view>
    <view class="segment-row" wx:for="{{task.segments}}" wx:key="id">
      <view class="seg-no">{{item.segmentNo}}</view>
      <view class="seg-info">
        <view>{{item.fromLocation}} → {{item.toLocation}}</view>
        <view class="meta">装车 / 到达见计划时间</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{task.status >= 3}}" bindtap="goReceipt">
    <view class="section-title">回单凭证</view>
    <view class="link-row">上传 / 查看回单 <text>›</text></view>
  </view>

  <view class="card">
    <view class="section-title">承运资源</view>
    <view class="kv"><text class="kv__k">主驾</text><text class="kv__v">{{task.mainDriverName || '-'}}</text></view>
    <view class="kv"><text class="kv__k">牵引车</text><text class="kv__v">{{task.plateNumber || '苏A·8F236'}}</text></view>
    <view class="kv"><text class="kv__k">挂车</text><text class="kv__v">{{trailerPlate}}</text></view>
    <view class="kv"><text class="kv__k">承运方式</text><text class="kv__v">{{carrierText}}</text></view>
    <view class="kv"><text class="kv__k">调度</text><text class="kv__v">{{dispatcherName}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">这一单的钱</view>
    <view class="finance-row">
      <view>
        <view class="label">已预付</view>
        <view class="amount">¥{{prepaidText}}</view>
      </view>
      <view>
        <view class="label">已结算</view>
        <view class="amount">¥{{settledText}}</view>
      </view>
      <view>
        <view class="label">待结算</view>
        <view class="amount">¥{{pendingText}}</view>
      </view>
    </view>
    <view class="link-row" bindtap="goFinance">查看费用单 <text>›</text></view>
  </view>

  <view class="card">
    <view class="section-title">流转记录</view>
    <view class="timeline">
      <view class="tl" wx:for="{{logs}}" wx:key="title">
        <view class="tl__t">{{item.title}}</view>
        <view class="tl__s">{{item.sub}}</view>
      </view>
    </view>
  </view>

  <view class="actionbar">
    <view class="btn btn--ghost btn--narrow" bindtap="onCall">
      <mp-icon name="phone" size="sm" />
      电话
    </view>
    <view class="btn btn--ghost btn--narrow" bindtap="openMore">
      <mp-icon name="more" size="sm" />
      更多
    </view>
    <view
      wx:if="{{mainAction}}"
      class="btn {{mainAction.level === 'primary' ? 'btn--accent' : 'btn--primary'}} grow"
      bindtap="onMain"
    >{{mainAction.label}}</view>
  </view>
</view>

<view class="loading-wrap" wx:else>
  <t-loading theme="circular" size="48rpx" text="正在加载任务，请稍候…" />
</view>

<view wx:if="{{sheet === 'more'}}" class="sheet-mask" bindtap="closeSheet"></view>
<view wx:if="{{sheet === 'more'}}" class="sheet">
  <view class="sheet__grab"></view>
  <view class="sheet__title">更多操作</view>
  <view class="sheet-item" bindtap="onNav">
    <mp-icon name="nav" size="md" color="#1d4ed8" />
    <text>导航去卸货点</text>
  </view>
  <view class="sheet-item" bindtap="onCallRecv">
    <mp-icon name="phone" size="md" color="#1d4ed8" />
    <text>联系收货方</text>
  </view>
  <view class="sheet-item" bindtap="onExcp">
    <mp-icon name="warn" size="md" color="#b26b00" />
    <text>上报异常</text>
  </view>
  <view class="sheet-item" bindtap="onCopy">
    <mp-icon name="file" size="md" color="#1d4ed8" />
    <text>复制单号</text>
  </view>
  <view class="btn btn--ghost btn--block" bindtap="closeSheet">取消</view>
</view>

<view wx:if="{{sheet === 'reject'}}" class="sheet-mask" bindtap="closeSheet"></view>
<view wx:if="{{sheet === 'reject'}}" class="sheet">
  <view class="sheet__grab"></view>
  <view class="sheet__title">拒绝调令</view>
  <view class="chips">
    <view
      wx:for="{{rejectReasons}}"
      wx:key="*this"
      class="chip {{rejectPick === item ? 'is-on' : ''}}"
      data-v="{{item}}"
      bindtap="pickReject"
    >{{item}}</view>
  </view>
  <t-textarea placeholder="补充说明" value="{{rejectReason}}" maxlength="{{255}}" bind:change="onRejectReason" />
  <view class="btnrow mt-16">
    <view class="btn btn--ghost" bindtap="closeSheet">先不拒</view>
    <view class="btn btn--danger" bindtap="submitReject">确认拒绝</view>
  </view>
</view>

<t-dialog
  visible="{{signVisible}}"
  title="确认签收"
  content="确认这台车已经交给接车人？"
  confirm-btn="确认签收"
  cancel-btn="取消"
  bind:confirm="submitSign"
  bind:cancel="closeSign"
  bind:close="closeSign"
/>
