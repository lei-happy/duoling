.tips {
  font-size: 24rpx;
  color: #5a6779;
  margin-bottom: 16rpx;
}

.history {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.history:last-child {
  border-bottom: none;
}

.history-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.history-img-wrap,
.history-img {
  width: 140rpx;
  height: 140rpx;
}
