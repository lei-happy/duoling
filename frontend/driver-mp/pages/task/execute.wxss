.cell-t { font-size: 30rpx; font-weight: 600; }
.meta { margin-top: 8rpx; font-size: 24rpx; color: #94a3b8; }
.picker { padding: 16rpx 0; font-size: 29rpx; }
.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 36rpx;
  font-weight: 650;
}
.stepper__b {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #eaf0ff;
  color: #1d4ed8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.actionbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.page-with-action { padding-bottom: 160rpx; }
