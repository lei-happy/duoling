.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.08);
}

.bar-inner {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.action-btn {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  border: none;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.action-btn.full {
  flex: 1;
}

.action-btn.flex {
  flex: 1;
}

.action-btn.primary {
  background: #1d4ed8;
}

.action-btn.success {
  background: #16a34a;
}

.action-btn.danger {
  background: #dc2626;
}

.action-btn[disabled] {
  opacity: 0.55;
}
