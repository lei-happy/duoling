<view class="bar safe-bottom" wx:if="{{actions.length}}">
  <view class="bar-inner">
    <t-button
      wx:for="{{viewActions}}"
      wx:key="key"
      class="action-btn {{viewActions.length > 1 ? 'flex' : 'full'}}"
      theme="{{item.theme}}"
      size="large"
      shape="round"
      block="{{viewActions.length === 1}}"
      loading="{{loading && currentKey === item.key}}"
      disabled="{{loading}}"
      data-key="{{item.key}}"
      bind:tap="onTap"
    >{{item.label}}</t-button>
  </view>
</view>
