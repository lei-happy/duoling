.task-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin: 0 24rpx 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.status-bar {
  width: 10rpx;
  flex-shrink: 0;
}

.status-default {
  background: #94a3b8;
}

.status-primary {
  background: #1d4ed8;
}

.status-success {
  background: #16a34a;
}

.status-warning {
  background: #f59e0b;
}

.status-danger {
  background: #dc2626;
}

.status-info {
  background: #0ea5e9;
}

.body {
  flex: 1;
  padding: 28rpx 28rpx 28rpx 24rpx;
}

.row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.task-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.route {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.loc {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
  max-width: 42%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  color: #94a3b8;
  font-size: 28rpx;
}

.row-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  font-size: 24rpx;
  color: #94a3b8;
}
