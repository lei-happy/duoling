.road {
  margin-top: 28rpx;
}

.road__lane {
  position: relative;
  height: 56rpx;
}

.road__track {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4rpx;
  height: 10rpx;
  border-radius: 10rpx;
  background: #d4dbe6;
  box-shadow: inset 0 -3rpx 0 #a8b3c2;
  overflow: hidden;
}

.road__fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(90deg, #1b3ba3, #1d4ed8);
  border-radius: 10rpx;
}

.road__truck {
  position: absolute;
  bottom: 10rpx;
  width: 88rpx;
  height: 40rpx;
  margin-left: -44rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  color: #1f2937;
  z-index: 2;
}

.road__truck .mp-icon {
  width: 88rpx;
  height: 40rpx;
}

.road__stops {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.road__stops text {
  flex: none;
  font-size: 23rpx;
  color: #94a3b8;
  line-height: 1.2;
}

.road__stops .is-done {
  color: #5a6779;
}

.road__stops .is-now {
  color: #b26b00;
  font-weight: 600;
}

.is-parked .road__fill {
  width: 0 !important;
}

.is-parked .road__truck {
  left: 0 !important;
  margin-left: 0;
}

.road--dark .road__track {
  background: rgba(255, 255, 255, 0.16);
  box-shadow: inset 0 -3rpx 0 rgba(0, 0, 0, 0.18);
}

.road--dark .road__fill {
  background: linear-gradient(90deg, #f59e0b, #f5a524);
}

.road--dark .road__truck {
  color: #fde68a;
}

.road--dark .road__stops text {
  color: rgba(255, 255, 255, 0.52);
}

.road--dark .road__stops .is-done {
  color: rgba(255, 255, 255, 0.68);
}

.road--dark .road__stops .is-now {
  color: #f5a524;
}
