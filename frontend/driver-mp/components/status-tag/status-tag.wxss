.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.tag-default {
  background: #f1f5f9;
  color: #64748b;
}

.tag-primary {
  background: #dbeafe;
  color: #1d4ed8;
}

.tag-success {
  background: #dcfce7;
  color: #16a34a;
}

.tag-warning {
  background: #fef3c7;
  color: #d97706;
}

.tag-danger {
  background: #fee2e2;
  color: #dc2626;
}

.tag-info {
  background: #e0f2fe;
  color: #0284c7;
}
