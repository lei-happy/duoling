.wb-wrap {
  position: relative;
}

.wb-wrap.is-stack {
  padding-bottom: 16rpx;
}

.wb-wrap__s2,
.wb-wrap__s1 {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  height: 36rpx;
  border-radius: 28rpx;
  background: #d5e6f8;
}

.wb-wrap__s2 {
  bottom: 0;
  left: 44rpx;
  right: 44rpx;
  background: #c4d8ef;
}

.wb-wrap__s1 {
  bottom: 8rpx;
}

.wb {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(29, 33, 41, 0.04);
}

.wb--running {
  background: linear-gradient(180deg, #cce9ff 0%, #ffffff 96rpx);
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(22, 115, 255, 0.08);
}

.wb__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 42rpx;
}

.wb__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.wb__status-t {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
}

.wb__status-t.is-new {
  color: #0065ff;
}

.wb__no {
  font-size: 30rpx;
  color: #1d2129;
}

.wb__copy {
  height: 32rpx;
  padding: 0 10rpx;
  border: 1rpx solid #86909c;
  border-radius: 4rpx;
  font-size: 20rpx;
  color: #86909c;
  line-height: 30rpx;
  flex-shrink: 0;
}

.wb__head-r {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  flex-shrink: 0;
}

.wb__type {
  font-size: 22rpx;
  font-weight: 500;
  color: #ef7c00;
}

.wb__km {
  font-size: 20rpx;
  color: #5d6570;
}

.wb__route {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.wb__axis {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: 6rpx;
}

.wb__dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.wb__dot.is-load {
  background: #0065ff;
}

.wb__dot.is-unload {
  background: #5d6570;
}

.wb__rail {
  width: 12rpx;
  flex: 1;
  min-height: 40rpx;
  margin: 8rpx 0;
  background: #e2e6ed;
  border-radius: 6rpx;
}

.wb__places {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 28rpx;
}

.wb__name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1d2129;
  line-height: 1.35;
}

.wb--pending .wb__name {
  font-size: 36rpx;
}

.wb__addr {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #86909c;
  line-height: 1.4;
}

.wb-road {
  margin-top: 28rpx;
}

.wb-road__lane {
  position: relative;
  height: 36rpx;
}

.wb-road__track,
.wb-road__fill {
  position: absolute;
  left: 0;
  top: 16rpx;
  height: 8rpx;
  border-radius: 8rpx;
}

.wb-road__track {
  right: 0;
  background: #cedae9;
}

.wb-road__fill {
  background: linear-gradient(90deg, #83cdff, #1673ff);
}

.wb-road__car {
  position: absolute;
  top: -4rpx;
  width: 44rpx;
  height: 44rpx;
  margin-left: -22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wb-road__labs {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.wb-road__labs text {
  font-size: 24rpx;
  color: #86909c;
}

.wb-road__labs .is-done {
  color: #86909c;
}

.wb-road__labs .is-now {
  color: #1d2129;
  font-weight: 600;
}

.wb__meta {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #eff4fa;
  border-radius: 20rpx;
}

.wb__meta-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  line-height: 1.6;
}

.wb__meta-k {
  font-size: 28rpx;
  color: #5d6570;
}

.wb__meta-v {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d2129;
}

.wb__meta-acc {
  font-size: 28rpx;
  font-weight: 500;
  color: #0065ff;
}

.wb__btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.wb__btns--end {
  margin-top: 0;
  flex: none;
}

.wb__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.wb__mile {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #5d6570;
}

.wb-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.wb-btn:active {
  opacity: 0.86;
}

.wb-btn--ghost {
  background: #fff;
  color: #0065ff;
  border: 1rpx solid #c9cdd4;
}

.wb-btn--plain {
  flex: none;
  width: 144rpx;
  background: #fff;
  color: #1d2129;
  border: 1rpx solid #c9cdd4;
}

.wb-btn--primary {
  background: #1673ff;
  color: #fff;
}

.wb-btn--sm {
  flex: none;
  width: 204rpx;
}
