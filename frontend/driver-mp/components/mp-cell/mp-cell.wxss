.cell {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  background: #fff;
  position: relative;
}

.cell:active {
  background: #f7f9fd;
}

.cell + .cell::before {
  content: "";
  position: absolute;
  left: 32rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: #f0f3f8;
}

.cell__ico {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf0ff;
  color: #1d4ed8;
}

.cell__ico.is-amber {
  background: #fff5e3;
  color: #b26b00;
}

.cell__ico.is-green {
  background: #e7f6ec;
  color: #16a34a;
}

.cell__ico.is-red {
  background: #fdeaea;
  color: #dc2626;
}

.cell__ico.is-letter {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(145deg, #2f5fe0, #1d4ed8);
}

.cell__mark {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: currentColor;
}

.cell__mark--wallet {
  width: 26rpx;
  height: 20rpx;
  border-radius: 6rpx;
}

.cell__mark--chart {
  width: 8rpx;
  height: 22rpx;
  border-radius: 4rpx;
  box-shadow: 12rpx 4rpx 0 currentColor, 24rpx -4rpx 0 currentColor;
}

.cell__mark--card {
  width: 28rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

.cell__mark--user {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  box-shadow: 0 16rpx 0 -2rpx currentColor;
}

.cell__mark--truck {
  width: 28rpx;
  height: 14rpx;
  border-radius: 4rpx 10rpx 4rpx 4rpx;
}

.cell__mark--star {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  transform: rotate(20deg);
}

.cell__mark--settings {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 6rpx #fff;
}

.cell__mark--bell {
  width: 18rpx;
  height: 20rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
}

.cell__mark--info {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
}

.cell__mark--building {
  width: 18rpx;
  height: 22rpx;
  border-radius: 4rpx 4rpx 0 0;
}

.cell__mark--fuel {
  width: 16rpx;
  height: 22rpx;
  border-radius: 4rpx 4rpx 6rpx 6rpx;
}

.cell__mark--check {
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  background: transparent;
  transform: rotate(-40deg);
  border-radius: 0;
}

.cell__mark--clock {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 4rpx currentColor;
}

.cell__mark--camera {
  width: 24rpx;
  height: 18rpx;
  border-radius: 6rpx;
}

.cell__main {
  flex: 1;
  min-width: 0;
}

.cell__t {
  display: block;
  font-size: 31rpx;
  font-weight: 500;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell__s {
  display: block;
  font-size: 25rpx;
  color: #94a3b8;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell__x {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #94a3b8;
  font-size: 28rpx;
  flex-shrink: 0;
}

.cell__e.is-ok {
  color: #16a34a;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.cell__e.is-dim {
  color: #94a3b8;
}

.cell__e.is-danger {
  color: #dc2626;
}

.cell__arr {
  font-size: 36rpx;
  color: #c3ccda;
  line-height: 1;
}
