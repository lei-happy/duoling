.cell {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  background: #fff;
  position: relative;
}

.cell:active {
  background: #f7f9fd;
}

.cell + .cell::before {
  content: "";
  position: absolute;
  left: 32rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: #f0f3f8;
}

.cell__ico {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf0ff;
  color: #1d4ed8;
}

.cell__ico.is-amber {
  background: #fff5e3;
  color: #b26b00;
}

.cell__ico.is-green {
  background: #e7f6ec;
  color: #16a34a;
}

.cell__ico.is-red {
  background: #fdeaea;
  color: #dc2626;
}

.cell__ico.is-letter {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(145deg, #2f5fe0, #1d4ed8);
}


.cell__main {
  flex: 1;
  min-width: 0;
}

.cell__t {
  display: block;
  font-size: 31rpx;
  font-weight: 500;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell__s {
  display: block;
  font-size: 25rpx;
  color: #94a3b8;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell__x {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #94a3b8;
  font-size: 28rpx;
  flex-shrink: 0;
}

.cell__e.is-ok {
  color: #16a34a;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.cell__e.is-dim {
  color: #94a3b8;
}

.cell__e.is-danger {
  color: #dc2626;
}

.cell__arr {
  font-size: 36rpx;
  color: #c3ccda;
  line-height: 1;
}
