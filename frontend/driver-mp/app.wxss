/** 智途驾驶员小程序全局样式 + TDesign 主题 */
page {
  /* TDesign 主题色（对齐原品牌蓝 #1d4ed8） */
  --td-brand-color: #1d4ed8;
  --td-brand-color-active: #1e40af;
  --td-brand-color-disabled: #93c5fd;
  --td-brand-color-focus: #dbeafe;
  --td-brand-color-light: #eff6ff;

  --brand-primary: #1d4ed8;
  --brand-primary-deep: #1b3ba3;
  --brand-primary-light: #3b82f6;
  --brand-primary-soft: #eaf0ff;
  --brand-accent: #f5a524;
  --brand-accent-deep: #b26b00;
  --brand-accent-soft: #fff5e3;
  --brand-success: #16a34a;
  --brand-warning: #f59e0b;
  --brand-danger: #dc2626;
  --brand-info: #0ea5e9;
  --hero-navy: #0d1b3e;
  --ink: #0f172a;
  --ink-2: #5a6779;
  --ink-3: #94a3b8;
  --text-primary: #0f172a;
  --text-secondary: #5a6779;
  --text-muted: #94a3b8;
  --bg-page: #f4f6fb;
  --bg-card: #ffffff;
  --border-color: #e7ebf3;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-ctl: 20rpx;
  --shadow-card: 0 2rpx 4rpx rgba(15, 23, 42, 0.04), 0 12rpx 32rpx -16rpx rgba(15, 23, 42, 0.1);

  background: var(--bg-page);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view,
text,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.page-with-action {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin: 24rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--text-muted);
}

.muted {
  color: var(--text-secondary);
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-actions {
  margin-top: 32rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.empty-hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
}
