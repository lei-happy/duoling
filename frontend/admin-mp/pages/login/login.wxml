<view class="page login-page">
  <view class="hero">
    <view class="brand">智途管理</view>
    <view class="slogan">经营数据与高频操作，随时掌握</view>
  </view>

  <view class="form card">
    <t-input
      label="手机号"
      type="number"
      maxlength="{{11}}"
      placeholder="请输入手机号"
      value="{{phone}}"
      layout="vertical"
      clearable
      bind:change="onPhone"
    />
    <t-input
      label="密码"
      type="password"
      placeholder="请输入密码"
      value="{{password}}"
      layout="vertical"
      clearable
      bind:change="onPassword"
    />

    <view class="actions">
      <t-button
        theme="primary"
        size="large"
        shape="round"
        block
        loading="{{loading}}"
        disabled="{{loading}}"
        bind:tap="onSubmit"
      >进入工作台</t-button>
    </view>

    <view class="hint muted">当前为脚手架演示登录，后续对接租户账号体系</view>
  </view>
</view>
