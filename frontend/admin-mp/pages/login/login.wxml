<view class="page login-page">
  <view class="hero">
    <view class="brand">智途管理</view>
    <view class="slogan">经营数据与高频操作，随时掌握</view>
  </view>

  <view class="form card">
    <t-input
      label="手机号"
      type="number"
      maxlength="{{11}}"
      placeholder="请输入手机号"
      value="{{phone}}"
      layout="vertical"
      clearable
      bind:change="onPhone"
    />
    <t-input
      label="密码"
      type="password"
      placeholder="请输入密码"
      value="{{password}}"
      layout="vertical"
      clearable
      bind:change="onPassword"
    />

    <view class="actions">
      <t-button
        theme="primary"
        size="large"
        shape="round"
        block
        loading="{{loading}}"
        disabled="{{loading}}"
        bind:tap="onSubmit"
      >进入工作台</t-button>
    </view>

    <view class="hint muted">使用企业员工账号登录，权限与电脑端一致</view>
  </view>

  <view wx:if="{{selectingTenant}}" class="card tenant-card">
    <view class="section-title">选择企业</view>
    <view class="tenant-hint muted">这个手机号关联了多家企业，请选择要进入的一家。</view>
    <view
      wx:for="{{tenants}}"
      wx:key="tenantCode"
      data-code="{{item.tenantCode}}"
      bindtap="onPickTenant"
    >
      <t-cell title="{{item.tenantName}}" note="{{item.tenantCode}}" arrow />
    </view>
  </view>
</view>
