.login-page { padding-bottom: 0; background: #0b132e; }
.hero {
  padding: 88rpx 48rpx 72rpx;
  color: #fff;
  background:
    radial-gradient(520px 320px at 84% -10%, rgba(250,140,22,.2), transparent 62%),
    linear-gradient(180deg, #0b132e 0%, #14205a 70%, #0e1740 100%);
}
.brand-mark {
  width: 96rpx; height: 96rpx; border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(150deg, #6b8bff, #2f54eb);
  font-size: 44rpx; font-weight: 700;
}
.brand { margin-top: 28rpx; font-size: 48rpx; font-weight: 700; }
.slogan { margin-top: 12rpx; font-size: 26rpx; color: rgba(210,222,255,.76); }
.lanes { display: flex; gap: 12rpx; margin-top: 48rpx; }
.lane { flex: 1; }
.lane__bar { height: 8rpx; border-radius: 99rpx; }
.lane text { display: block; margin-top: 10rpx; font-size: 18rpx; color: rgba(200,214,255,.62); }
.panel {
  margin-top: -24rpx;
  padding: 40rpx 44rpx 48rpx;
  min-height: 60vh;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
}
.tabs { display: flex; border-bottom: 1rpx solid #e5e9f2; margin-bottom: 12rpx; }
.tab { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; color: #94a3b8; font-weight: 600; }
.tab.is-on { color: #2f54eb; box-shadow: inset 0 -4rpx 0 #2f54eb; }
.field { padding: 20rpx 0; border-bottom: 1rpx solid #eff2f7; }
.label { display: block; font-size: 24rpx; color: #5a6779; margin-bottom: 10rpx; }
.field input { width: 100%; height: 64rpx; font-size: 30rpx; }
.code-row { display: flex; align-items: flex-end; gap: 16rpx; }
.grow { flex: 1; }
.code-btn { flex: none; height: 72rpx; line-height: 72rpx; padding: 0 20rpx; border-radius: 16rpx; background: #eef2ff; color: #2f54eb; font-size: 24rpx; font-weight: 600; }
.submit { width: 100%; margin-top: 36rpx; }
.agree { display: flex; gap: 12rpx; margin-top: 24rpx; font-size: 22rpx; color: #94a3b8; line-height: 1.55; }
.check { width: 28rpx; height: 28rpx; border-radius: 50%; border: 3rpx solid #cbd5e1; flex: none; margin-top: 4rpx; }
.check.is-on { background: #2f54eb; border-color: #2f54eb; }
.help { margin-top: 28rpx; text-align: center; font-size: 24rpx; color: #5a6779; }
