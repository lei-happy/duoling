<view class="page">
  <view class="sum">
    <view class="row__no">{{summary.no}}</view>
    <view class="row__m">{{summary.route}}</view>
    <view class="dim">{{summary.qty}} 台</view>
  </view>
  <view class="section"><text class="section__t">推荐运力</text><text class="section__s">已按空闲与距离排好</text></view>
  <view class="card" style="padding:8rpx 24rpx">
    <view wx:if="{{!caps.length}}" class="empty-wrap"><t-empty description="暂时没有可派运力，可改走承运商" /></view>
    <view
      wx:for="{{caps}}"
      wx:key="capacityId"
      class="cap {{picked.capacityId===item.capacityId ? 'is-on' : ''}}"
      data-id="{{item.capacityId}}"
      bindtap="onPick"
    >
      <view class="row__t">
        <text class="row__m">{{item.plateNumber}} · {{item.driverName}}</text>
        <text wx:if="{{item.best}}" class="tag tag--primary">最合适</text>
      </view>
      <view class="dim">{{item.reason}}</view>
    </view>
  </view>
  <view class="card margin">
    <view class="dim">本单预估毛利率（示意）</view>
    <view class="margin__v">{{margin}}%</view>
    <view class="dim">公司底线 12%。低于底线需走特价审批。</view>
  </view>
  <view class="actionbar">
    <button class="btn-primary" loading="{{loading}}" bindtap="onConfirm">确认派车</button>
  </view>
</view>
