<view class="page">
  <view class="card">
    <view class="row__no">{{item.waybillNo}}</view>
    <view class="dim">核对：张数、签字、盖章、日期</view>
  </view>
  <image wx:for="{{urls}}" wx:key="*this" src="{{item}}" class="big" mode="widthFix" data-src="{{item}}" bindtap="preview" />
  <view wx:if="{{!urls.length}}" class="notice">司机还没传图，也可以先确认回单（以计划状态为准）。</view>
  <view wx:if="{{tab===0}}" class="actionbar">
    <button class="btn-primary" bindtap="onConfirm">确认回单</button>
  </view>
</view>
