<view class="page">
  <view class="seg">
    <button class="{{tab===0?'is-on':''}}" data-tab="0" bindtap="onTab">待确认</button>
    <button class="{{tab===1?'is-on':''}}" data-tab="1" bindtap="onTab">已确认</button>
  </view>
  <view class="notice notice--info">确认是计划级动作。照片质检角标为示意，不拦确认。</view>
  <view class="card" style="padding:8rpx 24rpx">
    <view wx:if="{{!list.length}}" class="empty-wrap"><t-empty description="这一档没有回单" /></view>
    <view wx:for="{{list}}" wx:key="id" class="row">
      <view class="row__t">
        <text class="row__no">{{item.no}}</text>
        <text wx:if="{{item.mockFlag}}" class="tag tag--warn">{{item.mockFlag}}</text>
      </view>
      <view class="row__m">{{item.route}}</view>
      <view class="thumbs">
        <image wx:for="{{item.thumbs}}" wx:for-item="u" wx:key="*this" src="{{u}}" mode="aspectFill" class="thumb" />
      </view>
      <view class="acts">
        <text class="link" data-id="{{item.id}}" bindtap="onReview">看大图</text>
        <text wx:if="{{tab===0}}" class="link primary" data-id="{{item.id}}" bindtap="onConfirm">确认回单</text>
        <text wx:else class="link" data-id="{{item.id}}" bindtap="onRevoke">撤销</text>
      </view>
    </view>
  </view>
</view>
