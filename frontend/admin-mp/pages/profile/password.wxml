<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">当前密码</text>
      <input password placeholder="请输入当前密码" value="{{oldPassword}}" bindinput="onOld" />
    </view>
    <view class="field">
      <text class="label">新密码</text>
      <input password placeholder="至少 6 位" value="{{newPassword}}" bindinput="onNew" />
    </view>
    <view class="field">
      <text class="label">再输一遍新密码</text>
      <input password placeholder="请再次输入新密码" value="{{confirm}}" bindinput="onConfirm" />
    </view>
  </view>
  <view class="notice notice--info">改完后，当前登录仍然有效。下次请用新密码。</view>
  <view class="actionbar">
    <button class="btn-primary" loading="{{loading}}" bindtap="onSubmit">确认修改</button>
  </view>
</view>
