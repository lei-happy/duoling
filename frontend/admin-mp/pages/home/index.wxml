<view class="page home">
  <view class="hero">
    <view class="hello">{{hello}}，{{realName}}</view>
    <view class="sub muted-on-dark">{{sub}}</view>
    <view wx:if="{{showSwitcher}}" class="roles" role="tablist">
      <view
        wx:for="{{switchers}}"
        wx:key="value"
        class="role-tab {{item.selected ? 'is-on' : ''}}"
        data-persona="{{item.value}}"
        bindtap="onSwitch"
      >{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{emptyHint}}" class="card hint-card">
    <view class="hint-text">{{emptyHint}}</view>
  </view>

  <view wx:if="{{comingSoon}}" class="card hint-card">
    <view class="hint-text">车队长视图即将上线，先用现有入口了解待办方向。</view>
  </view>

  <view class="card">
    <view class="section-title">{{currentLabel}}速览</view>
    <view class="kpi-row">
      <view class="kpi" wx:for="{{kpis}}" wx:key="label">
        <view class="kpi-value">{{item.value}}</view>
        <view class="kpi-label">{{item.label}}</view>
      </view>
    </view>
    <view class="kpi-tip muted">数据接口将在后续迭代接入</view>
  </view>

  <view class="card">
    <view class="section-title">高频入口</view>
    <t-cell
      wx:for="{{entries}}"
      wx:key="title"
      title="{{item.title}}"
      note="{{item.note}}"
      arrow
    />
  </view>
</view>
