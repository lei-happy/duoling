<view class="page">
  <view class="card">
    <view class="dim">运营健康度（综合分含示意）</view>
    <view class="score">{{score}}</view>
    <view class="dim">最拖后腿的是{{drag}}</view>
  </view>
  <view class="notice notice--info">准点热力、目标线等对照数字当前为示意。状态分布来自真实运营效率接口。</view>
  <view class="card">
    <view class="section__t">状态分布</view>
    <view class="dim" style="margin-top:12rpx">锁定 {{locked}} 单。其余分布与电脑端一致。</view>
    <view wx:if="{{!statusDist.length}}" class="dim" style="margin-top:16rpx">这一段还没有状态数据</view>
    <view wx:for="{{statusDist}}" wx:key="status" class="row">
      <view class="row__m">{{item.label}}<text class="row__money">{{item.count}}</text></view>
    </view>
  </view>
</view>
