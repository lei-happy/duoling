# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
venv/
.venv/
env/

# ---- Node.js ----
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 构建产物 ----
frontend/console/dist/
frontend/client/dist/
frontend/website/dist/
frontend/console/es/
frontend/console/lib/
frontend/client/es/
frontend/client/lib/
frontend/template/es/
frontend/template/lib/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- 环境配置 ----
.env
.env.local
.env.*.local
!.env.example

# ---- 日志 ----
logs/
*.log
# 例外：开放平台「调用记录」是前端源码目录，并非运行日志，需纳入版本管理
!frontend/client/src/views/open-platform/logs/
!frontend/client/src/views/open-platform/logs/**

# ---- 缓存 ----
.cache/
.vite/
.pytest_cache/
.mypy_cache/

# ---- Docker ----
docker-compose.override.yml

# ---- 后端本地上传（测试素材勿入库） ----
backend/uploads/

# ---- 一次性脚本产出的回填 / 校验报告 ----
backend/reports/
